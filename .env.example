# ============================================
# RestaurantOS — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ── Database ──────────────────────────────────
# SQLite database path (relative to prisma/schema.prisma)
DATABASE_URL=file:./db/custom.db

# ── AI Assistant (Gemini) ─────────────────────
# Google Gemini API key for AI features (predictions, recommendations, chat)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── FURS Fiscalization (Slovenia) ─────────────
# Set to true for testing without real certificates
# Set to false for production with real FURS certificates
FURS_ALLOW_SIMULATION=true

# FURS certificate paths (for production)
# FURS_CERT_PATH=./certs/furs-cert.pem
# FURS_KEY_PATH=./certs/furs-key.pem

# FURS API endpoints
# FURS_API_URL=https://blagajne.fu.gov.si:9002
# FURS_TEST_API_URL=https://blagajne-test.fu.gov.si:9002

# ── App Configuration ─────────────────────────
# Public URL of the application (used for QR codes, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Port for the development server (default: 3000)
PORT=3000

# ── WebSocket Server ──────────────────────────
# Port for the WebSocket server (for real-time KDS updates)
# WS_PORT=3001

# ── Printing (ESC/POS) ───────────────────────
# Printer IP addresses or hostnames
# PRINTER_KITCHEN=192.168.1.100
# PRINTER_BAR=192.168.1.101
# PRINTER_RECEIPT=192.168.1.102
# PRINTER_PORT=9100

# ── SMS / Email Notifications ─────────────────
# Twilio SMS (for customer notifications)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+386xxxxxxxx

# SendGrid Email (for customer notifications)
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_FROM=noreply@yourrestaurant.com

# ── Payment Gateway ──────────────────────────
# Stripe (for online payments)
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Delivery Integrations ────────────────────
# Webhook secrets for verifying incoming delivery orders
# GLOVO_WEBHOOK_SECRET=your_glovo_secret
# WOLT_WEBHOOK_SECRET=your_wolt_secret
# BOLT_WEBHOOK_SECRET=your_bolt_secret

# ── Multi-Location ───────────────────────────
# Default location ID (used when no location is specified)
# DEFAULT_LOCATION_ID=1

# ── Security ─────────────────────────────────
# Session configuration
# SESSION_TTL_HOURS=8
# SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# ── Backup ───────────────────────────────────
# Automatic database backup interval (in hours, 0 = disabled)
# BACKUP_INTERVAL_HOURS=24
# BACKUP_PATH=./backups
