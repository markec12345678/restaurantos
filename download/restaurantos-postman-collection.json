    {
      "name": "Audit Log",
      "description": "Chain hash audit log - nepopravljiv",
      "item": [
        {
          "name": "Get Audit Log",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/audit-log?from=2025-09-01&to=2025-09-04",
              "host": ["{{base_url}}"],
              "path": ["audit-log"],
              "query": [
                { "key": "from", "value": "2025-09-01" },
                { "key": "to", "value": "2025-09-04" }
              ]
            },
            "description": "Pridobi audit log vnose z datumskim filtrom."
          }
        },
        {
          "name": "Verify Audit Chain",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/audit-log/verify", "host": ["{{base_url}}"], "path": ["audit-log", "verify"] },
            "description": "Verificiraj integriteto chain hash audit log-a (SHA-256). Super-admin only."
          },
          "event": [
            {
