// ============================================
// ZAPOSLENI, FUNKCIJE IN URE (Toast Labor API)
// ============================================

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  role      String   @default("staff")
  status    String   @default("active")
  hireDate  DateTime @default(now())
  // --- Toast: PIN za prijavo v POS ---
  pin       String   @unique @default("") // FIX SECURITY: 4-mestni PIN za hitro prijavo — @unique prepreči duplikate (impersonacijo)
  pinLookup String?  @unique // FIX PERF: HMAC-SHA256(NEXTAUTH_SECRET, pin) za O(1) iskanje pri prijavi (pin ostane bcrypt-hashiran za varno primerjavo)
  // --- Relations ---
  shifts       Shift[]
  staffShifts  StaffShift[]
  availability StaffAvailability[]
  timeOffRequests TimeOffRequest[]
  jobs         EmployeeJob[]
  timeEntries  TimeEntry[]
  cashShifts   CashRegisterShift[]
  waitlistEntries WaitlistEntry[]
  // FIX WORKFLOW-1: order.employee back-reference (FK relacija)
  orders       Order[]    @relation("OrderEmployee")
  postedJournalEntries JournalEntry[] @relation("PostedJournalEntries")
  pushSubscriptions PushSubscription[] @relation("PushSubscriptions")
  kotDocuments KotDocument[] @relation("KotDocuments")
  // --- Multi-location ---
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([pin])
  @@index([locationId])
}

model Job {
  id          String   @id @default(cuid())
  name        String   // "Natakar", "Kuhar", "Barman", "Vodja izmene", "Skladnik"
  code        String   @default("") // Kratka koda
  basePayRate Decimal  @default(0) // Osnovna urna postavka  // FIX: Decimal za valuto
  overtimeRate Decimal  @default(0) // Osnovna + 50% za presežek  // FIX: Decimal za valuto
  // --- Dovoljenja (JSON) ---
  permissions String   @default("[]") // ["take_orders", "void_items", "apply_discounts", "manage_cash", "admin"]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // --- Relations ---
  employees   EmployeeJob[]
  shifts      Shift[]
  timeEntries TimeEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: Ime funkcije mora biti unikatno — prepreči dvojne "Natakar" vnose
  @@unique([name])
  // FIX: isActive — filtriranje aktivnih delovnih mest
  @@index([isActive])
}

model EmployeeJob {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payRate    Decimal   @default(0) // Override osnovne plače za tega zaposlenega  // FIX: Decimal za valuto
  isPrimary  Boolean  @default(false) // Primarna funkcija
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, jobId])
  @@index([jobId])  // FIX: FK index — "kateri zaposleni imajo to delovno mesto?"
}

model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani plačilno zgodovino (soft-delete preko status='cancelled')
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  date       DateTime
  startTime  String   @default("09:00")
  endTime    String   @default("17:00")
  status     String   @default("scheduled") // scheduled, in_progress, completed, absent
  // --- Toast: Break Types ---
  breakMinutes Int    @default(30) // Skupaj minut odmora
  notes      String   @default("")
  // --- Multi-location (FIX: izmene so na lokaciji) ---
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([employeeId, date]) // Index for shift queries
  @@index([jobId])             // FIX: FK index — poizvedbe po delovnem mestu
  @@index([locationId]) // FIX: per-lokacija izmene
}

model TimeEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani evidence delovnih ur
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Clock In/Out ---
  clockIn     DateTime
  clockOut    DateTime?
  // --- Odmor ---
  breakStart  DateTime?
  breakEnd    DateTime?
  breakMinutes Int     @default(0) // Dejansko minut odmora
  // --- Izračun ---
  totalMinutes Int     @default(0) // Skupaj minut (brez odmora)
  payRate     Decimal   @default(0) // Urna postavka za ta vnos  // FIX: Decimal za valuto
  totalPay    Decimal   @default(0) // totalMinutes / 60 * payRate  // FIX: Decimal za valuto
  // --- Tip ---
  type        String   @default("regular") // regular, overtime, holiday, sick, vacation
  status      String   @default("active") // active, approved, disputed
  notes       String   @default("")
  // --- Multi-location (FIX: delovne ure so per-lokacija za plače) ---
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([clockIn])
  @@index([type])
  @@index([status])
  @@index([jobId])             // FIX: FK index — obračun plač po delovnem mestu
  @@index([locationId]) // FIX: per-lokacija evidence ur
}

// ============================================
// BLAGAJNA / IZMENE (Cash Register Shifts)
// ============================================

model CashRegisterShift {
  id                String   @id @default(cuid())
  employeeId        String?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  employeeName      String   @default("")
  status            String   @default("open")  // open, closed
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  startingCash      Decimal   @default(0) // Začetno stanje gotovine  // FIX: Decimal za valuto
  closingCash       Decimal   @default(0) // Končno stanje gotovine (dejansko štete)  // FIX: Decimal za valuto
  expectedCash      Decimal   @default(0) // Pričakovano stanje gotovine  // FIX: Decimal za valuto
  cashSales         Decimal   @default(0) // Prodaja v gotovini  // FIX: Decimal za valuto
  cardSales         Decimal   @default(0) // Kartična prodaja  // FIX: Decimal za valuto
  mobileSales       Decimal   @default(0) // Mobilna prodaja  // FIX: Decimal za valuto
  alternateSales    Decimal   @default(0) // Alternativna plačila (boni, vavčerji)  // FIX: Decimal za valuto
  splitPayments     Decimal   @default(0) // Deljena plačila  // FIX: Decimal za valuto
  totalSales        Decimal   @default(0) // Skupna prodaja  // FIX: Decimal za valuto
  totalOrders       Int      @default(0)       // Število naročil
  totalDiscounts    Decimal   @default(0) // Skupni popusti  // FIX: Decimal za valuto
  totalTips         Decimal   @default(0) // Skupne napitnine  // FIX: Decimal za valuto
  totalVoided       Decimal   @default(0) // Skupaj poničenih zneskov  // FIX: Decimal za valuto
  cashDifference    Decimal   @default(0) // Razlika (dejansko - pričakovano)  // FIX: Decimal za valuto
  notes             String   @default("")      // Opombe ob zaključku
  // --- Multi-location ---
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([openedAt])       // FIX SCHEMA-07: Index za poročila po datumskem obdobju
  @@index([locationId])     // FIX SCHEMA-07: Index za multi-location poizvedbe
  @@index([closedAt])       // FIX SCHEMA-09: Iskanje odprtih izmen (WHERE closedAt IS NULL)
}

model InventoryItem {
  id              String    @id @default(cuid())
  name            String
  description     String    @default("")           // Opis artikla
  image           String    @default("")           // Pot do slike
  unit            String    @default("pcs")       // Enota zaloge: steklenica, keg, kos, L, kg
  quantity        Decimal    @default(0)   // Količina na zalogi (v enotah)  // FIX: Decimal za natančnost
  minQuantity     Decimal    @default(0)   // Minimalna količina za opozorilo  // FIX: Decimal za natančnost
  costPerUnit     Decimal    @default(0)   // Nabavna cena na enoto zaloge  // FIX: Decimal za valuto
  supplier        String    @default("")           // Dobavitelj
  category        String    @default("general")    // Kategorija zaloge
  location         String    @default("main")       // Lokacija/skladišče: main, bar, kuhinja, hladilnik, klet, etc.
  expiryDate      DateTime?
  // --- NORMATIVI (standardizirano odmerjanje) ---
  servingsPerUnit Decimal    @default(1)  // Število servisov iz ene enote zaloge  // FIX: Decimal za natančnost
  servingSize     String    @default("")           // Velikost servisa
  costPerServing  Decimal    @default(0)  // Strošek na servis  // FIX: Decimal za valuto
  // --- Povezava z menijem ---
  menuItemId      String?   @unique
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  lastRestocked   DateTime  @default(now())
  // --- Transakcije ---
  transactions    StockTransaction[]
  recipeItems     RecipeItem[]
  purchaseOrderItems PurchaseOrderItem[]
  // --- AI Predictive Ordering ---
  reorderRule     ReorderRule?
  // --- Multi-location ---
  locationId      String?
  locationRel     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiryDate])
  @@index([name])
  @@index([category])
  @@index([locationId])
  @@index([supplier])
  @@index([location])
  @@index([quantity])
}

// ============================================
// ZALOŽNE TRANSAKCIJE (sledenje vseh premikov)
// ============================================

model StockTransaction {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani zalogo audit
  type            String        // "procurement", "sale", "write-off", "adjustment", "return"
  quantity        Decimal             // FIX: Decimal za natančnost
  previousQty     Decimal             // FIX: Decimal za natančnost
  newQty          Decimal             // FIX: Decimal za natančnost
  costPerUnit     Decimal             // FIX: Decimal za valuto
  totalCost       Decimal             // FIX: Decimal za valuto
  reason          String        @default("")
  note            String        @default("")
  supplierDoc     String        @default("")
  employeeName    String        @default("")
  orderId         String?
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
  @@index([inventoryItemId, type]) // FIX: Compound index for common queries (e.g., find sales per item)
  @@index([orderId])              // FIX: Index for stock transactions linked to orders
}

model RecipeItem {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantityPerServing Decimal    @default(0)  // FIX: Decimal za natančnost
  unit            String        @default("")
  notes           String        @default("")
  // FIX F5-4: Multi-level recipes — sub-recepti (npr. "pica testo" uporabljen v "margherita")
  parentRecipeItemId String?    // Če nastavljeno, je ta RecipeItem del nadrejenega recepta
  parentRecipeItem   RecipeItem? @relation("RecipeHierarchy", fields: [parentRecipeItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subRecipes         RecipeItem[] @relation("RecipeHierarchy")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])  // FIX: FK index — "kateri recepti uporabljajo to sestavino?"
}

// ============================================
// RAČUNI (Fiscal compliance - ZDDV-1)
// ============================================

model Receipt {
  id                String   @id @default(cuid())
  receiptNumber     String   @unique               // Sekvenčna številka: R-2026-000001
  orderId           String                         // Omogoča več računov na naročilo (split payments)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // --- Podatki izdajatelja ---
  businessName      String
  businessAddress   String
  businessId        String
  taxId             String
  registerId        String   @default("BLG-001")
  // --- Davčno potrjevanje (FURS) ---
  zoi               String   @default("")
  eor               String   @default("")
  fiscalVerified    Boolean  @default(false)
  fiscalStatus      String   @default("none")       // none, pending, verified, failed
  verificationDate  DateTime?
  // --- Vsebina računa ---
  subtotal          Decimal           // FIX: Decimal za valuto
  vatBreakdown      String   @default("{}")
  totalVat          Decimal           // FIX: Decimal za valuto
  discount          Decimal   @default(0)  // FIX: Decimal za valuto
  total             Decimal           // FIX: Decimal za valuto
  tip               Decimal   @default(0)  // FIX: Decimal za valuto
  totalWithTip      Decimal   @default(0) // FIX: Decimal za valuto
  paymentMethod     String
  // --- Meta ---
  isCopy            Boolean  @default(false)
  isStorno          Boolean  @default(false)
  stornoOf          String   @default("")
  printedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([fiscalVerified])
  @@index([createdAt])
  // FIX SCHEMA-04 HIGH: Compound index za isStorno+orderId — findFirst({orderId, isStorno: false}) v 5+ mestih
  @@index([orderId, isStorno])
  // FIX SCHEMA-04 MEDIUM: Index za fiscalStatus — batch processing unfiscalized receipts
  @@index([fiscalStatus])
}

// ============================================
// ZVESTOBNI PROGRAM (Toast Loyalty)
// ============================================

model LoyaltyAccount {
  id              String   @id @default(cuid())
  // --- Stranka ---
  customerName    String   @default("")
  customerPhone   String   @unique @default("") // FIX: prepreči duplikatne prijave na isto telefonsko številko
  customerEmail   String   @default("")
  // --- Točke ---
  pointsBalance   Int      @default(0)
  lifetimePoints  Int      @default(0)
  // --- Nivoji ---
  tier            String   @default("bronze") // bronze, silver, gold, platinum
  // --- Status ---
  isActive        Boolean  @default(true)
  // --- Relations ---
  transactions    LoyaltyTransaction[]
  payments        Payment[]
  guest           Guest?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerPhone])
  @@index([customerEmail])
  // FIX: isActive — filtriranje aktivnih loyalnostnih računov
  @@index([isActive])
  // FIX: tier — filtriranje po nivoju zvestobe (bronze, silver, gold, platinum)
  @@index([tier])
}

model LoyaltyTransaction {
  id              String         @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount  LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani zgodovino točk
  // --- Transakcija ---
  type            String         // earn, redeem, adjust, expire
  points          Int            // Pozitivno za earn, negativno za redeem
  reason          String         @default("") // "Nakup", "Rođendanski bonus", "Potečene točke"
  // --- Povezava z naročilom ---
  orderId         String?
  checkId         String?
  // --- Vrednost ---
  monetaryValue   Decimal         @default(0) // Vrednost v EUR, če se točke unovčijo  // FIX: Decimal za valuto
  createdAt       DateTime       @default(now())

  @@index([loyaltyAccountId])
  @@index([orderId])
  @@index([checkId])
  // FIX: type — filtriranje po vrsti transakcije (earn, redeem, adjust, expire)
  @@index([type])
  // FIX: createdAt — časovno filtriranje loyalnostnih transakcij
  @@index([createdAt])
  // FIX: Composite index — časovnica transakcij za račun zvestobe
  @@index([loyaltyAccountId, createdAt])
}

// ============================================
// DARILNE KARTICE (Toast Gift Cards)
// ============================================

model GiftCard {
  id              String   @id @default(cuid())
  cardNumber      String   @unique               // Številka kartice
  // --- Vrednost ---
  balance         Decimal   @default(0)     // Trenutno stanje  // FIX: Decimal za valuto
  initialBalance  Decimal   @default(0)     // Začetna vrednost  // FIX: Decimal za valuto
  // --- Status ---
  status          String   @default("active")     // active, depleted, expired, suspended
  // --- Lastnik ---
  ownerName       String   @default("")
  // --- Datumi ---
  purchasedAt     DateTime @default(now())
  expiresAt       DateTime?
  // --- Relations ---
  transactions    GiftCardTransaction[]
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
  @@index([status])
}

model GiftCardTransaction {
  id              String    @id @default(cuid())
  giftCardId      String
  giftCard        GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani zgodovino darilnih kartic
  // --- Transakcija ---
  type            String    // load, redeem, adjust, transfer
  amount          Decimal    // Pozitivno za load, negativno za redeem  // FIX: Decimal za valuto
  balanceAfter    Decimal    // Stanje po transakciji  // FIX: Decimal za valuto
  // --- Povezava ---
  orderId         String?
  checkId         String?
  note            String    @default("")
  createdAt       DateTime  @default(now())

  @@index([giftCardId])
  @@index([orderId])
  @@index([checkId])
  // FIX: type — filtriranje po vrsti transakcije (load, redeem, adjust, transfer)
  @@index([type])
  // FIX: createdAt — časovno filtriranje transakcij darilne kartice
  @@index([createdAt])
  // FIX: Composite index — zgodovina transakcij kartice po datumu
  @@index([giftCardId, createdAt])
}

// ============================================
// NASTAVITVE RESTAVRACIJE
// ============================================

model RestaurantSettings {
  id                String   @id @default(cuid())
  name              String   @default("RestaurantOS")
  address           String   @default("")
  city              String   @default("")
  postCode          String   @default("")
  phone             String   @default("")
  email             String   @default("")
  web               String   @default("")
  businessId        String   @default("")           // Matična številka podjetja
  taxId             String   @default("")           // ID za DDV (SIxxxxxxxxx)
  registerNumber    String   @default("BLG-001")    // Številka blagajne
  // --- FURS certifikat ---
  fursCertPath      String   @default("")
  fursCertPassword  String   @default("")
  fursEnvironment   String   @default("test")
  // --- DDV nastavitve ---
  defaultVatRate    Decimal   @default(22.00)  // FIX: Decimal za davčno stopnjo
  reducedVatRate    Decimal   @default(9.50)   // FIX: Decimal za davčno stopnjo
  // --- Loyalty nastavitve ---
  loyaltyEnabled    Boolean  @default(false)
  loyaltyPointsPerEuro Int   @default(1)            // Točk na porabljen EUR
  loyaltyPointsValue Decimal  @default(0.01) // Vrednost ene točke v EUR  // FIX: Decimal za valuto
  // --- Ostalo ---
  receiptFooter     String   @default("")
  currency          String   @default("EUR")
  locale            String   @default("sl-SI")
  country           String   @default("SI")         // Država poslovanja: SI, HR, IT, AT, DE
  // --- API Security (service-to-service auth) ---
  apiKeys           String   @default("[]")          // JSON: API ključi za cron/integrations (hashed)
  // --- Auto-gratuity ---
  autoGratuityEnabled   Boolean @default(false)       // Ali je auto-gratuiteta vklopljena
  autoGratuityPercent   Decimal  @default(10.00)  // Odstotek avto-gratuigete  // FIX: Decimal za odstotek
  autoGratuityThreshold Int     @default(6)           // Najmanjše število oseb za auto-gratuiteto
  // --- Allergen nastavitve ---
  allergenFilterEnabled Boolean @default(true)        // Ali je alergen filter vklopljen v POS
  // --- FASE 3: Email konfiguracija (scheduled reports) ---
  emailEnabled        Boolean  @default(false)   // Ali je email servis omogočen
  emailSmtpHost       String   @default("")      // SMTP strežnik (npr. smtp.gmail.com)
  emailSmtpPort       Int      @default(587)     // SMTP port (587=STARTTLS, 465=SSL)
  emailSmtpUser       String   @default("")      // SMTP uporabniško ime
  emailSmtpPassword   String   @default("")      // SMTP geslo (naj bo encrypted v produkciji)
  emailFromAddress    String   @default("")      // Naslov pošiljatelja (npr. reports@restaurant.com)
  emailReportRecipients String @default("[]")   // JSON: ["knjigovodja@racunovodja.si"] za dnevne Z-report
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// LOKACIJE (Multi-location podpora)
// Omogoča upravljanje več restavracij/poslovnih enot
// ============================================

model Location {
  id              String   @id @default(cuid())
  name            String                             // "Glavna restavracija", "Filiala Ljubljana", "Pop-up Maribor"
  code            String   @unique                    // Kratka koda: "HQ", "LJU", "MB"
  type            String   @default("restaurant")     // restaurant, food_truck, pop_up, cloud_kitchen, bar
  address         String   @default("")
  city            String   @default("")
  postCode        String   @default("")
  country         String   @default("SI")
  phone           String   @default("")
  email           String   @default("")
  // --- Poslovni podatki (lahko se razlikujejo od matične družbe) ---
  businessId      String   @default("")               // Matična št. za to lokacijo (lahko enaka kot matična)
  taxId           String   @default("")               // DDV ID za to lokacijo
  registerNumber  String   @default("")               // Blagajna za to lokacijo
  premisesId      String   @unique @default("") // FIX: FURS premises ID mora biti unikaten per lokacija
  // --- FURS certifikat (lokalen za lokacijo) ---
  fursCertPath    String   @default("")
  fursCertPassword String  @default("")
  fursEnvironment String   @default("test")
  // --- Nastavitve ---
  timezone        String   @default("Europe/Ljubljana")
  currency        String   @default("EUR")
  locale          String   @default("sl-SI")
  isOpen          Boolean  @default(false)            // Ali je lokacija trenutno odprta
  isActive        Boolean  @default(true)
  // --- Koordinate ---
  latitude        Float?
  longitude       Float?
  // --- Metapodatki ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relacije
  tables          Table[]
  orders          Order[]
  inventoryItems  InventoryItem[]
  employees       Employee[]
  cashShifts      CashRegisterShift[]
  reservations    Reservation[]
  deliveryZones   DeliveryZone[]
  openingHours    OpeningHours[]
  zReports        ZReport[]
  tipPools        TipPool[]
  deliveryTrackings DeliveryTracking[]
  staffShifts      StaffShift[]
  menus            Menu[]
  // --- Multi-location relations (FIX: per-lokacija evidence) ---
  haccpEntries     HaccpEntry[]
  shifts           Shift[]
  timeEntries      TimeEntry[]
  purchaseOrders   PurchaseOrder[]
  taxRates         TaxRate[]
  guestFeedbacks   GuestFeedback[]
  journalEntries   JournalEntry[]   // FIX issue #31: multi-location accounting
  virtualBrands    VirtualBrand[]   // Ghost kitchen hub
  devices          DeviceRegistry[] // FIX: Offline-first POS device tracking
  videoAnalytics   VideoAnalyticsSession[] // FIX: Video analytics per location

  @@index([code])
  @@index([isActive])
  @@index([type])
}

// ============================================
// CONE DOSTAVE (Delivery Zones)
// Toast-style zone-based delivery pricing
// ============================================

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String                             // "Center Ljubljana", "Rožna dolina", "Šiška"
  // --- Območje ---
  postCodes       String   @default("[]")            // JSON: ["1000","1001"] — poštne številke v coni
  cities          String   @default("[]")            // JSON: ["Ljubljana"] — mesta v coni
  // --- Radij (alternativa poštnim številkam) ---
  radiusKm        Float?                             // Radij v km od lokacije (null = uporabi postCodes)
  centerLat       Float?
  centerLng       Float?
  // --- Cenitev ---
  deliveryFee     Decimal   @default(2.50) // Cena dostave za to cono  // FIX: Decimal za valuto
  minOrderAmount  Decimal   @default(10.00) // Minimalno naročilo za to cono  // FIX: Decimal za valuto
  freeDeliveryAbove Decimal  @default(0)    // Brezplačna dostava nad ta znesek (0 = nikoli)  // FIX: Decimal za valuto
  // --- Čas ---
  estimatedMinutes Int     @default(30)              // Predviden čas dostave v minutah
  // --- Status ---
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  // --- Lokacija ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Metapodatki ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([isActive])
}

// ============================================
// DELOVNI ČAS (Opening Hours)
// Podpora za urnike po dnevih s prekinitvami
// ============================================

model OpeningHours {
  id              String   @id @default(cuid())
  // --- Dan v tednu ---
  dayOfWeek       Int                                // 0=nedelja, 1=ponedeljek, ..., 6=sobota
  // --- Čas odprtja/zaprtja ---
  openTime        String   @default("08:00")         // "08:00"
  closeTime       String   @default("22:00")         // "22:00"
  // --- Premor (opcijsko) ---
  breakStart      String   @default("")              // "14:00" (prazno = brez premora)
  breakEnd        String   @default("")              // "16:00"
  // --- Status ---
  isClosed        Boolean  @default(false)            // true = ta dan je zaprto
  // --- Lokacija ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Metapodatki ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([dayOfWeek])
  // FIX SCHEMA-07 HIGH: Compound unique — en dan enkrat na lokacijo, prepreči dvojne ponedeljke
  @@unique([locationId, dayOfWeek])
}

// ============================================
// HACCP DNEVNIKI
// ============================================

model HaccpEntry {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  category        String                        // temperature, cleaning, delivery, cooling, training
  title           String
  description     String   @default("")
  value           String   @default("")
  status          String   @default("ok")        // ok, warning, critical
  correctiveAction String  @default("")
  employeeName    String   @default("")
  // FIX F5-8: Kriptografska zaščita (hash chain) — EU 852/2004
  previousHash    String   @default("")  // Hash prejšnjega vnosa
  chainHash       String   @default("")  // SHA-256(previousHash + title + value + status + date)
  // --- Multi-location (FIX: HACCP mora biti per-lokacija za inšpekcije — EU 852/2004) ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([date])
  // FIX SCHEMA-10: Composite index za HaccpEntry — filtriranje po statusu znotraj datuma
  @@index([status, date])
  @@index([locationId]) // FIX: per-lokacija HACCP poročila
}

// ============================================
// WEBHOOKS / INTEGRACIJE
// ============================================

model Webhook {
  id          String   @id @default(cuid())
  name        String   // "Poslano v kuhinjo", "Plačilo prejeto", "Zaloga nizka"
  url         String   // Endpoint URL
  events      String   @default("[]") // JSON: ["order.created", "order.paid", "stock.low", "shift.started"]
  isActive    Boolean  @default(true)
  secret      String   @default("") // Za podpisovanje payloada
  lastTriggered DateTime?
  failureCount Int     @default(0)
  // --- Relations ---
  deliveries  WebhookDelivery[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([lastTriggered])
}

// ============================================
// ATOMICNI ŠTEVCI (Race-condition safe)
// ============================================

model Counter {
  id    String @id @default(cuid())
  name  String @unique  // "orderNumber", "receiptNumber", "checkNumber"
  value Int    @default(0)
}

// ============================================
// REVIZIJSKI DNEVNIK (Audit Log)
// PCI DSS + FURS skladnost — sledenje vseh operacij
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?  // ID zaposlenega, ki je izvedel operacijo
  action     String   // CREATE_ORDER, VOID_ITEM, PAYMENT, REFUND, LOGIN, STORNO, itd.
  entityType String   // Order, Payment, Receipt, StockItem, Employee, itd.
  entityId   String?  // ID entitete
  details    String   @default("{}") // JSON kontekst (kaj se je spremenilo)
  ipAddress  String   @default("")
  terminalId String?  // ID POS terminala
  previousHash String   @default("") // FIX COMPLIANCE: hash prejšnjega vnosa (SHA-256 veriga)
  chainHash    String   @default("") // hash tega vnosa (SHA-256(previousHash + payload)) — zaščita pred poseganjem

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([action])
}

// ============================================
// RAZPORED ZAPOLENIH / STAFF SHIFTS (7shifts + Toast standard)
// Tedenski razpored z izmenami, pokritost, ure
// ============================================

model StaffShift {
  id              String   @id @default(cuid())
  // --- Zaposleni ---
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani razpored zgodovino
  // --- Izmena ---
  shiftDate       DateTime                     // Datum izmene
  shiftType       String   @default("morning") // morning, afternoon, evening, night, split, custom
  startTime       String                       // HH:mm format
  endTime         String                       // HH:mm format
  // --- Lokacija ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Vloga ---
  role            String   @default("server")  // server, chef, bartender, host, manager, prep, dishwasher
  // --- Opombe ---
  notes           String   @default("")
  // --- Status ---
  status          String   @default("scheduled") // scheduled, confirmed, in_progress, completed, cancelled, no_show
  confirmedAt     DateTime?
  // --- Ure ---
  actualStart     DateTime?
  actualEnd       DateTime?
  breakMinutes    Int      @default(0)
  // --- Avtor ---
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftDate])
  @@index([locationId])
  @@index([status])
  @@index([shiftType])
  @@index([employeeId, shiftDate]) // Index for staff shift queries
  // FIX SCHEMA-10: Composite index za StaffShift — aktivne izmene danes
  @@index([status, shiftDate])
  @@index([shiftDate, locationId])
}

// ============================================
// STAFF AVAILABILITY (AI Scheduler input)
//============================================
model StaffAvailability {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Dan v tednu: 0=nedelja, 1=ponedelnik, ..., 6=sobota
  dayOfWeek    Int
  // Časovno okno (HH:mm)
  startTime    String                       // "07:00"
  endTime      String                       // "15:00"
  // Preference
  isPreferred  Boolean  @default(true)      // true = rade dela v tem oknu, false = na voljo v sili
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, dayOfWeek, startTime, endTime])
  @@index([employeeId])
  @@index([dayOfWeek])
}

// ============================================
// TIME OFF REQUEST ( dopust, bolniška, prost dan)
// ============================================
model TimeOffRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Tip
  type         String   @default("vacation") // vacation, sick, personal, holiday, unpaid
  // Časovno obdobje
  startDate    DateTime
  endDate    DateTime
  // Status
  status       String   @default("pending") // pending, approved, rejected, cancelled
  reason       String   @default("")
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([employeeId])
  @@index([startDate, endDate])
  @@index([status])
}

// ============================================
// REZERVACIJE (Toast Reservations — kar imajo TouchBistro in Toast)
// ============================================

model Reservation {
  id              String   @id @default(cuid())
  // --- Stranka ---
  customerName    String
  customerPhone   String   @default("")
  customerEmail   String   @default("")
  // --- Podatki rezervacije ---
  dateTime        DateTime                     // Datum in čas rezervacije
  partySize       Int                          // Število oseb
  duration        Int      @default(120)        // Trajanje v minutah (privzeto 2h)
  // --- Miza ---
  tableId         String?
  table           Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Status ---
  status          String   @default("confirmed") // confirmed, seated, completed, cancelled, no_show
  // --- Opombe ---
  notes           String   @default("")          // Posebne želje, alergije, praznovanja
  specialRequests String   @default("")          // Npr. "Otroški stol", "Ob oknu"
  // --- Sledenje ---
  source          String   @default("walk_in")   // walk_in, phone, website, app
  employeeId      String?
  waitlistEntries WaitlistEntry[]
  // --- Potrditev ---
  confirmedAt     DateTime?
  reminderSent    Boolean  @default(false)
  // --- Obisk ---
  actualArrival   DateTime?
  actualDeparture DateTime?
  // --- Multi-location ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dateTime])
  @@index([status])
  @@index([tableId])
  @@index([tableId, status]) // FIX: Compound index for reservation conflict checks
  @@index([locationId]) // Index for multi-location queries
  @@index([employeeId]) // FIX SCHEMA-09: Poročila po zaposlenem
  // FIX SCHEMA-10: Composite indexes za Reservation — pogoste poizvedbe
  @@index([dateTime, status])  // "Danesnje aktivne rezervacije" — najbolj pogosta poizvedba
  @@index([customerPhone])  // Iskanje rezervacij po telefonu
  @@unique([tableId, dateTime]) // FIX: ena miza, en čas = ena rezervacija
  @@index([source])  // Filtriranje po viru (walk_in, website, itd.)
  // FIX: Prepreči dvojno rezervacijo iste mize ob istem času (null tableId = walk-in, ne krši)
}

// ============================================
// GOST CRM / GUEST PROFILES (Toast Guest — kar imajo vsi top POS)
// Popolna zgodovina gosta, alergeni, preference, VIP status
// ============================================

model Guest {
  id              String   @id @default(cuid())
  // --- Osebni podatki ---
  firstName       String   @default("")
  lastName        String                        // Priimek (obvezen)
  email           String   @default("")
  phone           String   @default("")
  // --- Status ---
  isVip           Boolean  @default(false)
  vipSince        DateTime?
  // --- Alergeni in preference ---
  allergens       String   @default("[]")       // JSON: ["1","3","7"] (EU številke alergenov)
  dietaryPrefs    String   @default("[]")       // JSON: ["vegetarijansko","brez glutena","halal"]
  dislikes        String   @default("[]")       // JSON: ["lignji","gobe"] — kaj gost ne mara
  favoriteItems   String   @default("[]")       // JSON: ["Beefsteak","Laški teran"] — najljubše jedi
  // --- Osebni podatki ---
  birthday        DateTime?
  anniversary     DateTime?
  company         String   @default("")
  notes           String   @default("")         // Osebne opombe: "Rad sedi ob oknu"
  // --- Statistika (denormalizirano za hitre poizvedbe) ---
  totalVisits     Int      @default(0)
  totalSpent      Decimal   @default(0) // FIX: Decimal za valuto
  avgCheckAmount  Decimal   @default(0) // FIX: Decimal za valuto
  lastVisitAt     DateTime?
  firstVisitAt    DateTime?
  // --- Zvestoba ---
  loyaltyAccountId String?  @unique
  loyaltyAccount  LoyaltyAccount?  @relation(fields: [loyaltyAccountId], references: [id], onDelete: SetNull, onUpdate: SetNull) // FIX: SetNull — brisanje LoyaltyAccount ne blokira gosta
  // --- Povezave ---
  visits          GuestVisit[]
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastName])
  @@index([firstName])
  @@index([phone])
  @@index([email])
  @@index([isVip])
  @@index([lastVisitAt])
  // FIX SCHEMA-10: Composite indexes za Guest — pogoste poizvedbe
  @@index([lastName, firstName])  // Iskanje gosta po imenu in priimku
}

model GuestVisit {
  id              String   @id @default(cuid())
  guestId         String
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani zgodovino obiskov
  // --- Podatki obiska ---
  orderId         String?                       // Povezava z naročilom
  tableId         String?
  partySize       Int      @default(1)
  // --- Zneski ---
  totalSpent      Decimal   @default(0) // FIX: Decimal za valuto
  tipAmount       Decimal   @default(0) // FIX: Decimal za valuto
  // --- Kvaliteta ---
  feedbackScore   Int?                          // 1-5 ocena gosta
  feedbackComment String   @default("")
  // --- Kdo je strežil ---
  employeeId      String?
  employeeName    String   @default("")
  // FIX F5-8: Kriptografska zaščita (hash chain) — EU 852/2004
  previousHash    String   @default("")  // Hash prejšnjega vnosa
  chainHash       String   @default("")  // SHA-256(previousHash + title + value + status + date)
  // --- Čas ---
  arrivedAt       DateTime @default(now())
  departedAt      DateTime?
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([guestId])
  @@index([arrivedAt])
  // FIX SCHEMA-09: Missing indexes za GuestVisit
  @@index([employeeId])  // Poročila po natakarju
  @@index([guestId, arrivedAt])  // Časovnica obiskov gosta
  // FIX SCHEMA-10: Index za GuestVisit — iskanje obiskov po naročilu
  @@index([orderId])
}

// ============================================
// DOBAVITELJI / SUPPLIERS (Toast Supply Chain)
// ============================================

model Supplier {
  id              String   @id @default(cuid())
  name            String                        // "Mesarija Novak", "Pivovarna Laško"
  code            String   @unique @default("") // FIX: duplikatne kode prelomijo poročila
  // --- Kontakt ---
  contactPerson   String   @default("")
  email           String   @default("")
  phone           String   @default("")
  // --- Naslov ---
  address         String   @default("")
  city            String   @default("")
  postCode        String   @default("")
  country         String   @default("Slovenija")
  // --- Poslovni podatki ---
  businessId      String   @default("")         // Matična številka
  taxId           String   @default("")         // ID za DDV
  iban            String   @default("")         // IBAN za plačila
  bank            String   @default("")
  // --- Pogoji ---
  paymentTerms    String   @default("30 dni")   // "15 dni", "30 dni", "2% popust 10 dni"
  deliveryDays    String   @default("[]")       // JSON: ["pon","sre","pet"]
  minOrderAmount  Decimal   @default(0) // FIX: Decimal za valuto
  // --- FASE 3: Accounts Payable relation ---
  accountsPayables AccountsPayable[]
  // --- Ocena ---
  rating          Decimal   @default(0) // 1-5 ocena dobavitelja
  // --- Status ---
  isActive        Boolean  @default(true)
  notes           String   @default("")
  // --- Relations ---
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  // FIX SCHEMA-10: Unique constraint za Supplier — prepreči duplikate dobaviteljev
  @@unique([name])
}

// ============================================
// NAROČILA DOBAVITELJEM / PURCHASE ORDERS
// ============================================

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique              // "ND-2026-000001"
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // --- Status ---
  status          String   @default("draft")    // draft, sent, confirmed, partial, received, cancelled
  // --- Datumi ---
  orderDate       DateTime @default(now())
  expectedDate    DateTime?                     // Pričakovana dostava
  receivedDate    DateTime?                     // Dejanska dostava
  // --- Zneski ---
  subtotal        Decimal   @default(0) // FIX: Decimal za valuto
  vatAmount       Decimal   @default(0) // FIX: Decimal za valuto
  totalAmount     Decimal   @default(0) // FIX: Decimal za valuto
  // --- Dostava ---
  deliveryAddress String   @default("")
  deliveryNotes   String   @default("")
  // --- Interna ---
  requestedBy     String   @default("")         // Kdo je naročil
  approvedBy      String   @default("")         // Kdo je odobril
  // --- Multi-location (FIX: nabava je za zalogo lokacije) ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  notes           String   @default("")
  // --- Relations ---
  items           PurchaseOrderItem[]
  // --- FASE 3: Povezava z AccountsPayable ---
