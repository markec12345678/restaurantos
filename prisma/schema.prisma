// ============================================
// TIP POOL — Razdelitev napitnin (Toast standard)
// Samodejna ali ročna distribucija napitnin med zaposlene
// ============================================

model TipPool {
  id              String   @id @default(cuid())
  // --- Obdobje ---
  date            DateTime                           // Datum
  shiftId         String?                            // Povezava z izmeno (opcija)
  // --- Zneski ---
  totalTips       Decimal   @default(0) // Skupne napitnine  // FIX: Decimal za valuto
  cashTips        Decimal   @default(0) // FIX: Decimal za valuto
  cardTips        Decimal   @default(0) // FIX: Decimal za valuto
  // --- Metoda distribucije ---
  distributionMethod String  @default("equal")       // equal, hours, points, manual
  // --- Status ---
  status          String   @default("pending")       // pending, distributed, approved, paid
  // --- Dodelitve ---
