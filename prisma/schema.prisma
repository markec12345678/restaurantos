generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PROFESIONALNA MENU HIERARHIJA (Toast POS standard)
// Menu → Category → MenuItem → ModifierGroup → Modifier
// ============================================

model Menu {
  id         String     @id @default(cuid())
  name       String     // "Hrana", "Pijača"
  icon       String     @default("📋")
  color      String     @default("#f59e0b")
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  categories Category[]
  // --- Multi-location ---
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([locationId])
  // FIX: isActive — filtriranje aktivnih menijev (enak vzorec kot druge konfiguracije)
  @@index([isActive])
}

model Category {
  id         String     @id @default(cuid())
  name       String     // "Predjedi", "Glavne jedi", "Vroče pijače"
  icon       String     @default("🍽️")
  color      String     @default("#f59e0b")
  sortOrder  Int        @default(0)
  menuId     String
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // FIX SCHEMA-01 HIGH: Index za menuId — vsaka nalaga menija poizveduje po menuId
  @@index([menuId])
  // FIX SCHEMA-01 MEDIUM: Unique ime kategorije znotraj menija — prepreči duplikate
  @@unique([name, menuId])
}

model MenuItem {
  id              String           @id @default(cuid())
  name            String
  description     String           @default("")
  price           Decimal            // FIX: Decimal za valuto
  image           String           @default("")
  isAvailable     Boolean          @default(true)
  sortOrder       Int              @default(0)
  vatRate         Decimal           @default(22.00)     // DDV stopnja: 22.0, 9.5, 0 (%)  // FIX: Decimal za davčno stopnjo
  allergens       String           @default("")       // Alergeni: "1,3,7,12" (EU številke)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Toast: Sales Category (za poročila, ločeno od meni kategorije) ---
  salesCategoryId String?
  salesCategory   SalesCategory?   @relation(fields: [salesCategoryId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Price Group (različni ceniki) ---
  priceGroupId    String?
  priceGroup      PriceGroup?      @relation(fields: [priceGroupId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Revenue Center (bar, terasa, dostava) ---
  revenueCenterId String?
  revenueCenter   RevenueCenter?   @relation(fields: [revenueCenterId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Prep Station (kuhinja, bar) ---
  prepStationId   String?
  prepStation     PrepStation?     @relation(fields: [prepStationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Relations ---
  orderItems      OrderItem[]
  inventory       InventoryItem?
  recipeItems     RecipeItem[]
  modifierGroups  MenuItemModifierGroup[]
  mealtimeRules   MealtimeRule[]   // FIX MEALTIMES: per-item availability scheduling
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([categoryId])
  @@index([salesCategoryId])
  @@index([priceGroupId])
  @@index([revenueCenterId])
  @@index([prepStationId])
  @@index([isAvailable])
  // FIX SCHEMA-09: Composite indexes za pogoste poizvedbe
  @@index([categoryId, isAvailable])  // Prikaz menija: samo dostopni artikli v kategoriji
  @@index([categoryId, sortOrder])    // Urejen prikaz menija po kategoriji
}

// ============================================
// MEALTIMES — TastyIgniter-style per-item availability scheduling
// Artikel je dostopen samo ob določenih dneh/časih (npr. zajtrk 6-11h, nedeljska pečenka)
// ============================================

model MealtimeRule {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  name        String   @default("")       // "Zajtrk", "Kosilo", "Happy Hour"
  // Dnevi v tednu: 0=nedelja, 1=ponedelnik, ..., 6=sobota
  daysOfWeek  String   @default("[1,2,3,4,5]")  // JSON array
  // Časovno okno (prazno = cel dan)
  timeFrom    String   @default("")       // "06:00"
  timeTo      String   @default("")       // "11:00"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuItemId])
  @@index([isActive])
}

model ModifierGroup {
  id          String   @id @default(cuid())
  name        String   // "Način pečenja", "Priloge", "Velikost"
  required    Boolean  @default(false)
  minSelect   Int      @default(0)
  maxSelect   Int?     // null = neomejeno
  sortOrder   Int      @default(0)
  modifiers   Modifier[]
  menuItems   MenuItemModifierGroup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Modifier {
  id              String        @id @default(cuid())
  name            String        // "Srednje pečeno", "Francoski krompir"
  price           Decimal        @default(0)  // FIX: Decimal za valuto
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)
  // FIX ALLER-04 HIGH: Alergeni na modifierjih — "sir" (mleko), "oreščki" itd.
  allergens       String        @default("")       // Alergeni: "1,3,7,12" (EU številke), enak format kot MenuItem
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([modifierGroupId])
  // FIX: isAvailable — filtriranje dostopnih modifierjev (enak vzorec kot MenuItem)
  @@index([isAvailable])
}

model MenuItemModifierGroup {
  id              String        @id @default(cuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([modifierGroupId])  // FIX: FK index — "kateri artikli uporabljajo to modifikacijsko skupino?"
}

// ============================================
// KONFIGURACIJA (Toast Configuration API)
// ============================================

model TaxRate {
  id          String   @id @default(cuid())
  name        String   // "Standard DDV 22%", "Znižana DDV 9.5%", "Oproščeno 0%"
  rate        Decimal   // 22.0, 9.5, 0  // FIX: Decimal za davčno stopnjo
  code        String   @default("")  // "S", "R", "Z" (FURS kode)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // --- Multi-location (FIX: DDV se razlikuje po državi — Location.country) ---
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX SCHEMA-02 HIGH: FURS koda mora biti unikatna — prepreči dvojne "S" kode
  @@unique([code])
  diningOptions  DiningOption[] // FIX F5-7: Relation from DiningOption
  @@index([isActive])
  @@index([locationId]) // FIX: per-lokacija davčne stopnje
}

model DiningOption {
  id                String   @id @default(cuid())
  name              String   // "Na mestu", "Vzemi s seboj", "Dostava"
  type              String   // dine-in, takeout, delivery
  serviceChargeId   String?  // Povezana servisna postavka
  serviceCharge     ServiceCharge? @relation(fields: [serviceChargeId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  prepTimeMinutes   Int      @default(15) // Čas priprave v minutah
  // FIX F5-7: DDV override glede na lokacijo konzumacije (dine-in 9.5% vs takeaway 22%)
  taxRateId         String?  // Če nastavljeno, override MenuItem.vatRate
  taxRate           TaxRate?  @relation(fields: [taxRateId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // FIX SCHEMA-03 HIGH: type mora biti unikaten — findFirst({type: 'dine-in'}) predpostavlja enoličnost
  @@unique([type])
  @@index([isActive])
  @@index([serviceChargeId])   // FIX: FK index — iskanje po servisni postavki
}

model RevenueCenter {
  id          String   @id @default(cuid())
  name        String   // "Bar", "Terasa", "Dostava", "Glavna dvorana"
  code        String   @default("")  // Kratka koda za poročila
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  tables      Table[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih centrov prihodkov
  @@index([isActive])
}

model ServiceCharge {
  id          String   @id @default(cuid())
  name        String   // "Servisna postavka 10%", "Paketnina za dostavo"
  type        String   // percentage, fixed
  amount      Decimal   // Odstotek ali fiksni znesek  // FIX: Decimal za valuto
  isAutoApply Boolean  @default(false) // Samodejno dodaj
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  diningOptions DiningOption[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih servisnih postavk
  @@index([isActive])
}

model SalesCategory {
  id          String   @id @default(cuid())
  name        String   // "Hrana", "Pijača", "Alkoholne pijače", "Sladice", "Kava"
  code        String   @default("")  // Kratka koda za poročila
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih prodajnih kategorij
  @@index([isActive])
}

model PriceGroup {
  id          String   @id @default(cuid())
  name        String   // "Redni cenik", "Happy Hour", "Lunch Special", "Catering"
  description String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems      MenuItem[]
  happyHourSchedules HappyHourSchedule[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih cenikov
  @@index([isActive])
}

model PrepStation {
  id          String   @id @default(cuid())
  name        String   // "Vroča kuhinja", "Hladna kuhinja", "Bar", "Pekarna"
  type        String   @default("kitchen") // kitchen, bar, pastry, grill
  avgPrepTime Int      @default(15) // Povprečen čas priprave v minutah
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih postaj priprave
  @@index([isActive])
  // FIX: type — filtriranje po vrsti postaje (kitchen, bar, pastry, grill)
  @@index([type])
}

model AlternatePaymentType {
  id          String   @id @default(cuid())
  name        String   // "Dijaški bon", "Malica", "Vavčer", "Žeton"
  code        String   @default("")
  type        String   @default("voucher") // voucher, coupon, subsidy, token
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih vrst plačil
  @@index([isActive])
  // FIX: type — filtriranje po vrsti (voucher, coupon, subsidy, token)
  @@index([type])
}

model VoidReason {
  id          String   @id @default(cuid())
  name        String   // "Napaka natakarja", "Kuhinja zgrešila", "Stranka zamenjala mnenje", "Alergija"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih razlogov za poničenje
  @@index([isActive])
}

model NoSaleReason {
  id          String   @id @default(cuid())
  name        String   // "Mali dvig", "Vračilo dobavitelju", "Izplačilo napitnine", "Zamenjava"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih razlogov za nerealizacijo
  @@index([isActive])
}

model Printer {
  id          String   @id @default(cuid())
  name        String   // "Kuhinja 1", "Bar tiskalnik", "Blagajna"
  type        String   @default("thermal") // thermal, dot-matrix, label
  location    String   @default("") // Fizična lokacija
  ipAddress   String   @default("") // IP naslov omrežnega tiskalnika
  isActive    Boolean  @default(true)
  // Kaj se tiska na tem tiskalniku (JSON array)
  printRules  String   @default("[]") // [{type: "order", prepStationId: "..."}, {type: "receipt"}]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih tiskalnikov
  @@index([isActive])
  // FIX: type — filtriranje po vrsti tiskalnika (thermal, dot-matrix, label)
  @@index([type])
}

model PackagingConfig {
  id          String   @id @default(cuid())
  name        String   // "Standard embalaža", "Premium embalaža"
  isActive    Boolean  @default(true)
  items       PackagingItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FIX: isActive — filtriranje aktivnih konfiguracij embalaže
  @@index([isActive])
}

model PackagingItem {
  id                String          @id @default(cuid())
  name              String          // "Kartonska škatla", "Alu folija", "Vrečka za pijačo"
  price             Decimal          @default(0) // Dodatna cena za embalažo  // FIX: Decimal za valuto
  packagingConfigId String
  packagingConfig   PackagingConfig @relation(fields: [packagingConfigId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([packagingConfigId])  // FIX: FK index — iskanje embalaže po konfiguraciji
  // FIX: isActive — filtriranje aktivnih elementov embalaže
  @@index([isActive])
}

// ============================================
// NAROČILA, ČEKI IN PLAČILA (Toast Orders API)
// ============================================

model Table {
  id              String   @id @default(cuid())
  number          Int      // FIX SCHEMA-03: Odstranjen @unique — tabela number mora biti unikat samo znotraj lokacije
  capacity        Int      @default(4)
  status          String   @default("available")
  area            String   @default("main")
  // --- Vizualni tloris (drag-and-drop koordinate) ---
  posX            Float    @default(0)     // X pozicija na tlorisu (0-100%)
  posY            Float    @default(0)     // Y pozicija na tlorisu (0-100%)
  width           Float    @default(8)     // Širina v % tlorisa
  height          Float    @default(10)    // Višina v % tlorisa
  shape           String   @default("round") // round, square, rectangular, booth
  rotation        Float    @default(0)     // Rotacija v stopinjah
  // --- Povezave ---
  revenueCenterId String?
  revenueCenter   RevenueCenter? @relation(fields: [revenueCenterId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  orders          Order[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([revenueCenterId])
  @@index([status])
  @@index([locationId])
  // FIX SCHEMA-03: Compound unique — miza 1 je lahko na več lokacijah, ampak enkrat na lokacijo
  @@unique([number, locationId])
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     Int        @unique
  // --- Toast: Dining Option ---
  diningOptionId  String?
  diningOption    DiningOption? @relation(fields: [diningOptionId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  type            String     @default("dine-in") // dine-in, takeout, delivery
  status          String     @default("pending")
  tableId         String?
  table           Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Revenue Center ---
  revenueCenterId String?
  revenueCenter   RevenueCenter? @relation(fields: [revenueCenterId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Stranka / Gost CRM ---
  guestId         String?
  guest           Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  customerName    String     @default("")
  customerPhone   String     @default("")
  customerEmail   String     @default("")
  // --- Zneski (iz čekov agregirano) ---
  subtotal        Decimal     @default(0)  // FIX: Decimal za valuto
  tax             Decimal     @default(0)  // FIX: Decimal za valuto
  discount        Decimal     @default(0)  // FIX: Decimal za valuto
  tip             Decimal     @default(0)  // FIX: Decimal za valuto
  total           Decimal     @default(0)  // FIX: Decimal za valuto
  totalWithTip    Decimal     @default(0)  // FIX: Decimal za valuto
  // --- Status plačila ---
  paymentStatus   String     @default("unpaid")
  paymentMethod   String     @default("")
  splitCount      Int        @default(1)
  notes           String     @default("")
  employeeId      String?
  // FIX WORKFLOW-1: FK relacija do Employee (prej samo soft-FK employeeId)
  employee        Employee?  @relation("OrderEmployee", fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // FIX WORKFLOW-2: firedAt — čas, kdaj je naročilo poslano v kuhinjo (KDS timer + waiter elapsed)
  firedAt         DateTime?
  // --- Preklic/Storno metapodatki ---
  cancelReason    String     @default("")   // Razlog za preklic/storno
  cancelledAt     DateTime?                 // Kdaj je bilo preklicano/stornirano
  cancelledBy     String     @default("")   // Kdo je preklical (employeeId ali ime)
  // --- Razknjiževanje zaloge (prepreči dvojno razknjiževanje) ---
  inventoryDeducted Boolean   @default(false) // Ali je bila zaloga že razknjižena
  // --- Čas plačila ---
  paidAt          DateTime?                  // Kdaj je bilo plačano
  // --- Toast: Delivery Info ---
  deliveryInfoId  String?   @unique
  deliveryInfo    DeliveryInfo? @relation(fields: [deliveryInfoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Relations ---
  orderItems      OrderItem[]
  courses         Course[]
  checks          Check[]
  receipt         Receipt[]
  kotDocuments    KotDocument[]   // URY Mosaic-style KOT lifecycle
  // --- Ghost kitchen: virtual brand ---
  virtualBrandId  String?
  virtualBrand    VirtualBrand? @relation(fields: [virtualBrandId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Multi-location ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([tableId])
  @@index([createdAt])
  @@index([paidAt]) // FIX: Index for financial/paidAt queries (EOD, VAT, financial reports)
  @@index([locationId])
  @@index([employeeId]) // FIX: Index for employee reports and tips-by-employee queries
  @@index([status, paymentStatus]) // FIX: Compound index for common filter pattern
  @@index([paidAt, paymentStatus]) // Index for financial reports
  @@index([type]) // Index for order type filtering
  // FIX SCHEMA-10: Dodatni composite indexes za Order — najpogostejše poizvedbe
  @@index([status, createdAt])  // KDS: aktivna naročila po času (pending, preparing, itd.)
  @@index([createdAt, status])  // Dashboard: današnja naročila po statusu
  @@index([diningOptionId])     // FIX: FK index — poizvedbe po načinu strežbe
  @@index([revenueCenterId])    // FIX: FK index — poizvedbe po centru prihodkov
  @@index([guestId])            // FIX: FK index — CRM poizvedbe: "naročila gosta"
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Toast: Check povezava ---
  checkId        String?
  check          Check?   @relation(fields: [checkId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Artikel ---
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quantity       Int      @default(1)
  price          Decimal                        // Cena brez DDV  // FIX: Decimal za valuto
  vatRate        Decimal   @default(22.00)   // DDV stopnja tega artikla  // FIX: Decimal za davčno stopnjo
  vatAmount      Decimal   @default(0)      // Znesek DDV za ta artikel  // FIX: Decimal za valuto
  notes          String   @default("")
  modifiersJson  String   @default("[]") // JSON array of selected modifiers [{name, price}]
  menuItemName   String   @default("") // FIX: Denormalizirano ime artikla za naročila
  // --- Toast: Void/Poničitev ---
  voided         Boolean  @default(false)
  voidReasonId   String?
  voidReason     VoidReason? @relation(fields: [voidReasonId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Discounts na artikel ---
  discountAmount Decimal   @default(0)  // FIX: Decimal za valuto
  appliedDiscountId String?
  appliedDiscount Discount? @relation(fields: [appliedDiscountId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Course (fine dining) ---
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Status ---
  status         String   @default("pending")
  // FIX WORKFLOW-3: firedAt — čas, kdaj je artikel poslan v kuhinjo (KDS urgency timer)
  firedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([checkId])
  @@index([menuItemId])
  // FIX SCHEMA-06 HIGH: Index za voided — EOD poročila filtrirajo voided artikle
  @@index([voided])
  // FIX SCHEMA-06 MEDIUM: Index za courseId — course routes poizvedujejo po course
  @@index([courseId])
  // FIX SCHEMA-10: Composite indexes za OrderItem — ne-poničene postavke naročila
  @@index([orderId, voided])  // EOD poročila: ne-poničene postavke na naročilo
  @@index([orderId, status])  // KDS: prikaz statusa postavk za naročilo
  @@index([voidReasonId])     // FIX: FK index — EOD poročila o razlogih za poničenje
  @@index([appliedDiscountId]) // FIX: FK index — analiza popustov po postavkah
}

// ============================================
// ČEKI (Toast Checks — več čekov na naročilo)
// ============================================

model Check {
  id              String     @id @default(cuid())
  checkNumber     Int                           // Sekvenčna številka čeka znotraj naročila
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Zneski čeka ---
  subtotal        Decimal     @default(0)  // FIX: Decimal za valuto
  tax             Decimal     @default(0)  // FIX: Decimal za valuto
  discount        Decimal     @default(0)  // FIX: Decimal za valuto
  serviceCharge   Decimal     @default(0)  // Servisna postavka  // FIX: Decimal za valuto
  total           Decimal     @default(0)  // Subtotal + tax - discount + serviceCharge  // FIX: Decimal za valuto
  tip             Decimal     @default(0)  // FIX: Decimal za valuto
  totalWithTip    Decimal     @default(0)  // FIX: Decimal za valuto
  // --- Plačilo čeka ---
  paymentStatus   String     @default("unpaid") // unpaid, partial, paid
  paymentMethod   String     @default("")
  // --- Popusti na ček ---
  appliedDiscountId String?
  appliedDiscount  Discount?  @relation(fields: [appliedDiscountId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Relations ---
  orderItems      OrderItem[]
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([orderId, checkNumber])
  @@index([orderId])
  @@index([paymentStatus])
  // FIX SCHEMA-10: Composite indexes za Check — pogoste poizvedbe
  @@index([paymentStatus, orderId])  // Iskanje neplačanih čekov za naročilo
  @@index([appliedDiscountId])       // FIX: FK index — analiza popustov po čekih
}

model Payment {
  id                    String                @id @default(cuid())
  checkId               String
  check                 Check                 @relation(fields: [checkId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ohrani finančno revizijsko sled
  // --- Znesek ---
  amount                Decimal                // Plačani znesek  // FIX: Decimal za valuto
  refundAmount          Decimal   @default(0) // FIX: Delni povračila — znesek, ki je bil povrnjen
  tipAmount             Decimal   @default(0) // Napitnina  // FIX: Decimal za valuto
  // --- Vrsta plačila ---
  type                  String                // cash, card, mobile, voucher, loyalty, giftcard, alternate
  // --- Toast: Alternate Payment Type ---
  alternatePaymentTypeId String?
  alternatePaymentType  AlternatePaymentType? @relation(fields: [alternatePaymentTypeId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Kartica ---
  cardType              String   @default("") // visa, mastercard, maestro, diners, amex
  cardLast4             String   @default("") // Zadnje 4 številke
  authorizationCode     String   @default("") // Koda avtorizacije
  // --- Toast: Gift Card ---
  giftCardId            String?
  giftCard              GiftCard?             @relation(fields: [giftCardId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Toast: Loyalty ---
  loyaltyAccountId      String?
  loyaltyAccount        LoyaltyAccount?       @relation(fields: [loyaltyAccountId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  loyaltyPointsUsed     Int      @default(0)
  // --- Status ---
  status                String   @default("completed") // completed, refunded, voided
  employeeId            String?
  // FIX HIGH: Idempotency key za deduplikacijo plačil (double-click protection)
  idempotencyKey        String?  @unique  // Enolični ključ — prepreči duplikate
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([checkId])
  @@index([type])
  @@index([status])
  @@index([createdAt])      // FIX SCHEMA-07: Index za finančna poročila po datumu
  @@index([employeeId])     // FIX SCHEMA-07: Index za poročila o napitninah po zaposlenem
  @@index([alternatePaymentTypeId]) // FIX: FK index — poročila o alternativnih plačilih
  @@index([giftCardId])            // FIX: FK index — usklajevanje stanja darilnih kartic
  @@index([loyaltyAccountId])      // FIX: FK index — revizija loyalnostnih točk
}

model Discount {
  id          String   @id @default(cuid())
  name        String   // "Happy Hour -20%", "Zaposleniški popust", "Domači rojstni dan"
  type        String   // percentage, fixed_amount, buy_x_get_y
  amount      Decimal   // Odstotek ali znesek (odvisno od type)  // FIX: Decimal za valuto
  // --- Pogoji ---
  appliesTo   String   @default("check") // check, item, category
  triggerType String   @default("manual") // manual, auto, promo_code
  promoCode   String   @default("") // Koda za aktivacijo
  // --- Omejitve ---
  maxUses     Int?     // null = neomejeno
  currentUses Int      @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // --- Relations ---
  orderItems  OrderItem[]
  checks      Check[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([promoCode])
  @@index([isActive])
  @@index([triggerType])
}

model DeliveryInfo {
  id              String   @id @default(cuid())
  // --- Naslov ---
  address         String   // Ulica in hišna številka
  city            String   @default("")
  postCode        String   @default("")
  // --- Kontakt ---
  recipientName   String   @default("")
  recipientPhone  String   @default("")
  deliveryInstructions String @default("") // Navodila za dostavo (npr. "3. nadstropje, levo")
  // --- Čas ---
  promisedTime    DateTime? // Obljubljen čas dostave
  estimatedTime   DateTime? // Predviden čas dostave
  actualTime      DateTime? // Dejanski čas dostave
  // --- Courier ---
  courierName     String   @default("")
  courierPhone    String   @default("")
  // --- Status ---
  status          String   @default("pending") // pending, preparing, ready, picked_up, delivered, failed
  // --- Pakiranje ---
  packagingFee    Decimal   @default(0) // Strošek embalaže  // FIX: Decimal za valuto
  deliveryFee     Decimal   @default(0) // Strošek dostave  // FIX: Decimal za valuto
  // --- Koordinate ---
  latitude        Float?
  longitude       Float?
  // --- Relations ---
