  orderUnit       String   @default("pcs")
  // --- Dobavitelj ---
  preferredSupplierId String?
  // --- Lead time ---
  leadTimeDays    Int      @default(2)              // Koliko dni traja dostava
  // --- Status ---
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  lastOrderId     String?                           // Zadnji PO ID
  // --- Meta ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([triggerType])
}

// ============================================
// ČAKALNA VRSTA / WAITLIST (Toast Waitlist)
