{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/reserve/layout,_N_T_/reserve/page,_N_T_/reserve"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/reserve/__PAGE__",
    "/reserve",
    "/_index",
    "/_head"
  ]
}