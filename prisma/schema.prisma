  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  // FIX: Composite index — nadzorna plošča dobavitelja: naročila po statusu
  @@index([supplierId, status])
  @@index([locationId]) // FIX: per-lokacija nabava
}

model PurchaseOrderItem {
