  // --- Multi-location ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([locationId])
}

model TipDistribution {
  id              String   @id @default(cuid())
  tipPoolId       String
  tipPool         TipPool  @relation(fields: [tipPoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Zaposleni ---
  employeeId      String
  employeeName    String   @default("")
  // FIX F5-8: Kriptografska zaščita (hash chain) — EU 852/2004
  previousHash    String   @default("")  // Hash prejšnjega vnosa
  chainHash       String   @default("")  // SHA-256(previousHash + title + value + status + date)
  // --- Ure ---
  hoursWorked     Decimal   @default(0)  // Ure v izmeni  // FIX: Decimal za ure
  // --- Točke (za points metodo) ---
  points          Decimal   @default(0)  // FIX: Decimal za natančnost
  // --- Znesek ---
  amount          Decimal   @default(0) // Dodeljen znesek napitnine  // FIX: Decimal za valuto
  // --- Status ---
  status          String   @default("pending")       // pending, paid
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([tipPoolId])
  @@index([employeeId])
  @@index([status])
  @@index([paidAt])  // FIX SCHEMA-09: Poračila o plačanih napitninah
  @@index([employeeId, status])  // FIX: Pogosta poizvedba — neporačunane napitnine po zaposlenem
}

// ============================================
