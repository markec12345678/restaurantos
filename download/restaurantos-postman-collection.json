            "url": { "raw": "{{base_url}}/inventory/adjust", "host": ["{{base_url}}"], "path": ["inventory", "adjust"] },
            "body": { "mode": "raw", "raw": "{\n  \"itemId\": \"clinv1\",\n  \"newQuantity\": 23.0,\n  \"reason\": \"inventura\",\n  \"note\": \"Manjka 2.5 kg\"\n}" }
          }
        }
      ]
    },
