# ============================================
# RestaurantOS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ── Database ──────────────────────────────────
# SQLite path (relative to project root). Use absolute path in production.
DATABASE_URL="file:./db/custom.db"

# ── App ───────────────────────────────────────
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RestaurantOS"
NEXT_PUBLIC_DEFAULT_LOCALE="sl"
# ISO 3166-1 alpha-2 country code (drives VAT rules, currency, locale fallback)
COUNTRY_CODE="SI"

# ── Auth / Sessions ───────────────────────────
# Secret used to sign session tokens (use a long random string, e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Secret for signing digital-receipt access tokens (HMAC-SHA256).
# MUST be set in production — without it, digital receipts are unavailable.
RECEIPT_TOKEN_SECRET="change-me-to-another-random-string"
# Enable WebAuthn/FIDO2 biometric login (Touch ID, Face ID, Windows Hello, YubiKey).
# - false (default): WebAuthn disabled, PIN login only
# - true: WebAuthn enabled (works in dev with localhost, or prod with HTTPS)
# In production with HTTPS origin, WebAuthn is auto-enabled regardless of this flag.
# Signature verification uses @simplewebauthn/server (ES256/RS256/EdDSA — FIDO2 compliant).
WEBAUTHN_ENABLED="false"

# ── Cache (rate-limit + WebAuthn challenge store) ──────
# Optional: Redis URL for multi-replica deployments (Vercel/Render/ECS/Cloud Run).
# If unset, uses in-memory cache (single-instance only — rate limits bypass-able across replicas).
# Format: redis://[user:pass@]host:port[/db] or rediss:// for TLS.
# Issue #39: set this in production with >1 replica.
REDIS_URL=""
# API key required for POST /api/iot/readings (X-IoT-Api-Key header).
# Without this, IoT temperature submissions are rejected (fail-closed).
# Generate with: openssl rand -hex 32
IOT_API_KEY=""

# ── AI (Gemini / z-ai-web-dev-sdk) ────────────
# Required for AI forecast, recommendations, and assistant modules.
GEMINI_API_KEY=""

# ── FURS — Davčno potrjevanje računov ─────────
# Environment: "test" or "production"
FURS_ENV="test"
# Path to FURS PKCS12 certificate (relative to project root)
FURS_CERT_PATH="./certs/furs.p12"
# Password for the FURS certificate
FURS_CERT_PASSWORD=""
# Tax number of the issuer (Davčna številka)
FURS_TAX_NUMBER=""
# Allow simulation mode when no certificate is configured.
# SECURITY: Default 'false' — production deployments MUST set this to 'true' explicitly
# only for dev/test, otherwise FURS operations will fail-closed (no silent simulation).
FURS_ALLOW_SIMULATION="false"

# ── Card terminal (bančni terminal) ───────────
TERMINAL_PROVIDER=""
TERMINAL_IP=""
TERMINAL_PORT=""
TERMINAL_API_KEY=""

# ── Webhooks ──────────────────────────────────
# Secret for verifying signed incoming webhooks (Glovo/Wolt/Bolt)
WEBHOOK_SECRET=""

# ── WebSocket server (custom server.js) ───────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000"

# ── Logging ───────────────────────────────────
LOG_LEVEL="info"
LOG_FORMAT="pretty"

# ── Rate limiting (public APIs) ───────────────
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# ── WebSocket broadcast service token (interni) ──
WS_BROADCAST_SECRET="change-me-to-random-32-hex-chars"

# ── Web Push Notifications (VAPID) ─────────────
# Generiraj ključe z: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@tvoja-restavracija.si"

# ── SMS Notifications (98% open rate) ──────────
# Provider: "twilio" ali "messagebird"
SMS_PROVIDER=""
SMS_FROM=""              # +386XXXXXXXX (pošiljatelj)
SMS_ACCOUNT_SID=""       # Twilio Account SID
SMS_AUTH_TOKEN=""        # Twilio Auth Token
SMS_API_KEY=""           # MessageBird API key

# ── QR Pay-at-Table ────────────────────────────
# NEXT_PUBLIC_APP_URL je že nastavljen zgoraj

# ── Vercel Cron ────────────────────────────────
CRON_SECRET=""           # Token za Vercel Cron avtentikacijo
