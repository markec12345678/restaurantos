{
  "name": "restaurantos",
  "version": "1.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18.0.0"
  },
  "//": "P1-deps: edini package manager je Bun (CI + start script). package-lock.json je ODSTRANJEN — npm/yarn/pnpm lockfile-i so prepovedani, da CI --frozen-lockfile ostane deterministicen.",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:ws": "node server.js",
    "postbuild": "node scripts/copy-standalone.mjs",
    "build": "node scripts/db-sync.mjs && next build",
    "start": "bun .next/standalone/server.js",
    "start:ws": "NODE_ENV=production node server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration --config vitest.config.integration.ts",
    "db:init-pglite": "node scripts/init-pglite.mjs",
    "test:e2e": "playwright test",
    "test:deploy": "node scripts/deploy-test.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "npx tsx scripts/verify-features.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
