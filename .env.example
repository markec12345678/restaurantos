# ============================================
# RestaurantOS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ── Database ──────────────────────────────────
# SQLite path (relative to project root). Use absolute path in production.
DATABASE_URL="file:./db/custom.db"

# ── App ───────────────────────────────────────
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RestaurantOS"
NEXT_PUBLIC_DEFAULT_LOCALE="sl"
# ISO 3166-1 alpha-2 country code (drives VAT rules, currency, locale fallback)
COUNTRY_CODE="SI"

# ── Auth / Sessions ───────────────────────────
# Secret used to sign session tokens (use a long random string, e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Secret for signing digital-receipt access tokens (HMAC-SHA256).
# MUST be set in production — without it, digital receipts are unavailable.
RECEIPT_TOKEN_SECRET="change-me-to-another-random-string"
# Enable WebAuthn/FIDO2 biometric login (EXPERIMENTAL — signature verification
# is NOT yet implemented; only enable in closed test environments).
WEBAUTHN_ENABLED="false"

# ── IoT sensors ───────────────────────────────
# API key required for POST /api/iot/readings (X-IoT-Api-Key header).
# Without this, IoT temperature submissions are rejected (fail-closed).
# Generate with: openssl rand -hex 32
IOT_API_KEY=""

# ── AI (Gemini / z-ai-web-dev-sdk) ────────────
# Required for AI forecast, recommendations, and assistant modules.
GEMINI_API_KEY=""

# ── FURS — Davčno potrjevanje računov ─────────
# Environment: "test" or "production"
FURS_ENV="test"
# Path to FURS PKCS12 certificate (relative to project root)
FURS_CERT_PATH="./certs/furs.p12"
# Password for the FURS certificate
FURS_CERT_PASSWORD=""
# Tax number of the issuer (Davčna številka)
FURS_TAX_NUMBER=""
# Allow simulation mode when no certificate is configured.
# SECURITY: Default 'false' — production deployments MUST set this to 'true' explicitly
# only for dev/test, otherwise FURS operations will fail-closed (no silent simulation).
FURS_ALLOW_SIMULATION="false"

# ── Card terminal (bančni terminal) ───────────
TERMINAL_PROVIDER=""
TERMINAL_IP=""
TERMINAL_PORT=""
TERMINAL_API_KEY=""

# ── Webhooks ──────────────────────────────────
# Secret for verifying signed incoming webhooks (Glovo/Wolt/Bolt)
WEBHOOK_SECRET=""

# ── WebSocket server (custom server.js) ───────
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000"

# ── Logging ───────────────────────────────────
LOG_LEVEL="info"
LOG_FORMAT="pretty"

# ── Rate limiting (public APIs) ───────────────
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
