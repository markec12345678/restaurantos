// ============================================
// REORDER RULE — Avtomatska pravila naročanja
// ============================================
// Definira kdaj in koliko avtomatsko naročiti za posamezni artikel.
// Uporablja se v povezavi z AI forecast-om in StockTransaction zgodovino.
// ============================================
model ReorderRule {
  id              String   @id @default(cuid())
  inventoryItemId String   @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Trigger ---
  triggerType     String   @default("min_qty")     // "min_qty", "forecast_7d", "forecast_14d", "manual"
  triggerThreshold Decimal  @default(0)             // Količina ali dni do izpraznitve
  // --- Količina naročila ---
