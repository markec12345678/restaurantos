generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// PROFESIONALNA MENU HIERARHIJA (Toast POS standard)
// Menu → Category → MenuItem → ModifierGroup → Modifier
// ============================================

model Menu {
  id         String     @id @default(cuid())
  name       String     // "Hrana", "Pijača"
  icon       String     @default("📋")
  color      String     @default("#f59e0b")
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  categories Category[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Category {
  id         String     @id @default(cuid())
  name       String     // "Predjedi", "Glavne jedi", "Vroče pijače"
  icon       String     @default("🍽️")
  color      String     @default("#f59e0b")
  sortOrder  Int        @default(0)
  menuId     String
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model MenuItem {
  id              String           @id @default(cuid())
  name            String
  description     String           @default("")
  price           Float
  image           String           @default("")
  isAvailable     Boolean          @default(true)
  sortOrder       Int              @default(0)
  vatRate         Float            @default(22.0)     // DDV stopnja: 22.0, 9.5, 0 (%)
  allergens       String           @default("")       // Alergeni: "1,3,7,12" (EU številke)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // --- Toast: Sales Category (za poročila, ločeno od meni kategorije) ---
  salesCategoryId String?
  salesCategory   SalesCategory?   @relation(fields: [salesCategoryId], references: [id])
  // --- Toast: Price Group (različni ceniki) ---
  priceGroupId    String?
  priceGroup      PriceGroup?      @relation(fields: [priceGroupId], references: [id])
  // --- Toast: Revenue Center (bar, terasa, dostava) ---
  revenueCenterId String?
  revenueCenter   RevenueCenter?   @relation(fields: [revenueCenterId], references: [id])
  // --- Toast: Prep Station (kuhinja, bar) ---
  prepStationId   String?
  prepStation     PrepStation?     @relation(fields: [prepStationId], references: [id])
  // --- Relations ---
  orderItems      OrderItem[]
  inventory       InventoryItem?
  recipeItems     RecipeItem[]
  modifierGroups  MenuItemModifierGroup[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ModifierGroup {
  id          String   @id @default(cuid())
  name        String   // "Način pečenja", "Priloge", "Velikost"
  required    Boolean  @default(false)
  minSelect   Int      @default(0)
  maxSelect   Int?     // null = neomejeno
  sortOrder   Int      @default(0)
  modifiers   Modifier[]
  menuItems   MenuItemModifierGroup[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Modifier {
  id              String        @id @default(cuid())
  name            String        // "Srednje pečeno", "Francoski krompir"
  price           Float         @default(0)
  isAvailable     Boolean       @default(true)
  sortOrder       Int           @default(0)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model MenuItemModifierGroup {
  id              String        @id @default(cuid())
  menuItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
}

// ============================================
// KONFIGURACIJA (Toast Configuration API)
// ============================================

model TaxRate {
  id          String   @id @default(cuid())
  name        String   // "Standard DDV 22%", "Znižana DDV 9.5%", "Oproščeno 0%"
  rate        Float    // 22.0, 9.5, 0
  code        String   @default("")  // "S", "R", "Z" (FURS kode)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DiningOption {
  id                String   @id @default(cuid())
  name              String   // "Na mestu", "Vzemi s seboj", "Dostava"
  type              String   // dine-in, takeout, delivery
  serviceChargeId   String?  // Povezana servisna postavka
  serviceCharge     ServiceCharge? @relation(fields: [serviceChargeId], references: [id])
  prepTimeMinutes   Int      @default(15) // Čas priprave v minutah
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RevenueCenter {
  id          String   @id @default(cuid())
  name        String   // "Bar", "Terasa", "Dostava", "Glavna dvorana"
  code        String   @default("")  // Kratka koda za poročila
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  tables      Table[]
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCharge {
  id          String   @id @default(cuid())
  name        String   // "Servisna postavka 10%", "Paketnina za dostavo"
  type        String   // percentage, fixed
  amount      Float    // Odstotek ali fiksni znesek
  isAutoApply Boolean  @default(false) // Samodejno dodaj
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  diningOptions DiningOption[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalesCategory {
  id          String   @id @default(cuid())
  name        String   // "Hrana", "Pijača", "Alkoholne pijače", "Sladice", "Kava"
  code        String   @default("")  // Kratka koda za poročila
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceGroup {
  id          String   @id @default(cuid())
  name        String   // "Redni cenik", "Happy Hour", "Lunch Special", "Catering"
  description String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems      MenuItem[]
  happyHourSchedules HappyHourSchedule[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PrepStation {
  id          String   @id @default(cuid())
  name        String   // "Vroča kuhinja", "Hladna kuhinja", "Bar", "Pekarna"
  type        String   @default("kitchen") // kitchen, bar, pastry, grill
  avgPrepTime Int      @default(15) // Povprečen čas priprave v minutah
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  menuItems   MenuItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AlternatePaymentType {
  id          String   @id @default(cuid())
  name        String   // "Dijaški bon", "Malica", "Vavčer", "Žeton"
  code        String   @default("")
  type        String   @default("voucher") // voucher, coupon, subsidy, token
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VoidReason {
  id          String   @id @default(cuid())
  name        String   // "Napaka natakarja", "Kuhinja zgrešila", "Stranka zamenjala mnenje", "Alergija"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NoSaleReason {
  id          String   @id @default(cuid())
  name        String   // "Mali dvig", "Vračilo dobavitelju", "Izplačilo napitnine", "Zamenjava"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Printer {
  id          String   @id @default(cuid())
  name        String   // "Kuhinja 1", "Bar tiskalnik", "Blagajna"
  type        String   @default("thermal") // thermal, dot-matrix, label
  location    String   @default("") // Fizična lokacija
  ipAddress   String   @default("") // IP naslov omrežnega tiskalnika
  isActive    Boolean  @default(true)
  // Kaj se tiska na tem tiskalniku (JSON array)
  printRules  String   @default("[]") // [{type: "order", prepStationId: "..."}, {type: "receipt"}]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PackagingConfig {
  id          String   @id @default(cuid())
  name        String   // "Standard embalaža", "Premium embalaža"
  isActive    Boolean  @default(true)
  items       PackagingItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PackagingItem {
  id                String          @id @default(cuid())
  name              String          // "Kartonska škatla", "Alu folija", "Vrečka za pijačo"
  price             Float           @default(0) // Dodatna cena za embalažo
  packagingConfigId String
  packagingConfig   PackagingConfig @relation(fields: [packagingConfigId], references: [id], onDelete: Cascade)
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// ============================================
// NAROČILA, ČEKI IN PLAČILA (Toast Orders API)
// ============================================

model Table {
  id              String   @id @default(cuid())
  number          Int      @unique
  capacity        Int      @default(4)
  status          String   @default("available")
  area            String   @default("main")
  // --- Vizualni tloris (drag-and-drop koordinate) ---
  posX            Float    @default(0)     // X pozicija na tlorisu (0-100%)
  posY            Float    @default(0)     // Y pozicija na tlorisu (0-100%)
  width           Float    @default(8)     // Širina v % tlorisa
  height          Float    @default(10)    // Višina v % tlorisa
  shape           String   @default("round") // round, square, rectangular, booth
  rotation        Float    @default(0)     // Rotacija v stopinjah
  // --- Povezave ---
  revenueCenterId String?
  revenueCenter   RevenueCenter? @relation(fields: [revenueCenterId], references: [id])
  orders          Order[]
  reservations    Reservation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id              String     @id @default(cuid())
  orderNumber     Int        @unique
  // --- Toast: Dining Option ---
  diningOptionId  String?
  diningOption    DiningOption? @relation(fields: [diningOptionId], references: [id])
  type            String     @default("dine-in") // dine-in, takeout, delivery
  status          String     @default("pending")
  tableId         String?
  table           Table?     @relation(fields: [tableId], references: [id])
  // --- Toast: Revenue Center ---
  revenueCenterId String?
  revenueCenter   RevenueCenter? @relation(fields: [revenueCenterId], references: [id])
  // --- Stranka / Gost CRM ---
  guestId         String?
  guest           Guest?      @relation(fields: [guestId], references: [id])
  customerName    String     @default("")
  customerPhone   String     @default("")
  customerEmail   String     @default("")
  // --- Zneski (iz čekov agregirano) ---
  subtotal        Float      @default(0)
  tax             Float      @default(0)
  discount        Float      @default(0)
  tip             Float      @default(0)
  total           Float      @default(0)
  totalWithTip    Float      @default(0)
  // --- Status plačila ---
  paymentStatus   String     @default("unpaid")
  paymentMethod   String     @default("")
  splitCount      Int        @default(1)
  notes           String     @default("")
  employeeId      String?
  // --- Preklic/Storno metapodatki ---
  cancelReason    String     @default("")   // Razlog za preklic/storno
  cancelledAt     DateTime?                 // Kdaj je bilo preklicano/stornirano
  cancelledBy     String     @default("")   // Kdo je preklical (employeeId ali ime)
  // --- Razknjiževanje zaloge (prepreči dvojno razknjiževanje) ---
  inventoryDeducted Boolean   @default(false) // Ali je bila zaloga že razknjižena
  // --- Čas plačila ---
  paidAt          DateTime?                  // Kdaj je bilo plačano
  // --- Toast: Delivery Info ---
  deliveryInfoId  String?   @unique
  deliveryInfo    DeliveryInfo? @relation(fields: [deliveryInfoId], references: [id])
  // --- Relations ---
  orderItems      OrderItem[]
  courses         Course[]
  checks          Check[]
  receipt         Receipt[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([tableId])
  @@index([createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // --- Toast: Check povezava ---
  checkId        String?
  check          Check?   @relation(fields: [checkId], references: [id])
  // --- Artikel ---
  menuItemId     String
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id])
  quantity       Int      @default(1)
  price          Float                         // Cena brez DDV
  vatRate        Float    @default(22.0)       // DDV stopnja tega artikla
  vatAmount      Float    @default(0)          // Znesek DDV za ta artikel
  notes          String   @default("")
  modifiersJson  String   @default("[]") // JSON array of selected modifiers [{name, price}]
  // --- Toast: Void/Poničitev ---
  voided         Boolean  @default(false)
  voidReasonId   String?
  voidReason     VoidReason? @relation(fields: [voidReasonId], references: [id])
  // --- Toast: Discounts na artikel ---
  discountAmount Float    @default(0)
  appliedDiscountId String?
  appliedDiscount Discount? @relation(fields: [appliedDiscountId], references: [id])
  // --- Course (fine dining) ---
  courseId        String?
  course          Course?   @relation(fields: [courseId], references: [id])
  // --- Status ---
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// ============================================
// ČEKI (Toast Checks — več čekov na naročilo)
// ============================================

model Check {
  id              String     @id @default(cuid())
  checkNumber     Int                           // Sekvenčna številka čeka znotraj naročila
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // --- Zneski čeka ---
  subtotal        Float      @default(0)
  tax             Float      @default(0)
  discount        Float      @default(0)
  serviceCharge   Float      @default(0)     // Servisna postavka
  total           Float      @default(0)     // Subtotal + tax - discount + serviceCharge
  tip             Float      @default(0)
  totalWithTip    Float      @default(0)
  // --- Plačilo čeka ---
  paymentStatus   String     @default("unpaid") // unpaid, partial, paid
  paymentMethod   String     @default("")
  // --- Popusti na ček ---
  appliedDiscountId String?
  appliedDiscount  Discount?  @relation(fields: [appliedDiscountId], references: [id])
  // --- Relations ---
  orderItems      OrderItem[]
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ============================================
// PLAČILA (Toast Payments/Tender)
// ============================================

model Payment {
  id                    String                @id @default(cuid())
  checkId               String
  check                 Check                 @relation(fields: [checkId], references: [id], onDelete: Cascade)
  // --- Znesek ---
  amount                Float                 // Plačani znesek
  tipAmount             Float    @default(0)  // Napitnina
  // --- Vrsta plačila ---
  type                  String                // cash, card, mobile, voucher, loyalty, giftcard, alternate
  // --- Toast: Alternate Payment Type ---
  alternatePaymentTypeId String?
  alternatePaymentType  AlternatePaymentType? @relation(fields: [alternatePaymentTypeId], references: [id])
  // --- Kartica ---
  cardType              String   @default("") // visa, mastercard, maestro, diners, amex
  cardLast4             String   @default("") // Zadnje 4 številke
  authorizationCode     String   @default("") // Koda avtorizacije
  // --- Toast: Gift Card ---
  giftCardId            String?
  giftCard              GiftCard?             @relation(fields: [giftCardId], references: [id])
  // --- Toast: Loyalty ---
  loyaltyAccountId      String?
  loyaltyAccount        LoyaltyAccount?       @relation(fields: [loyaltyAccountId], references: [id])
  loyaltyPointsUsed     Int      @default(0)
  // --- Status ---
  status                String   @default("completed") // completed, refunded, voided
  employeeId            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ============================================
// POPUSTI (Toast Discounts)
// ============================================

model Discount {
  id          String   @id @default(cuid())
  name        String   // "Happy Hour -20%", "Zaposleniški popust", "Domači rojstni dan"
  type        String   // percentage, fixed_amount, buy_x_get_y
  amount      Float    // Odstotek ali znesek (odvisno od type)
  // --- Pogoji ---
  appliesTo   String   @default("check") // check, item, category
  triggerType String   @default("manual") // manual, auto, promo_code
  promoCode   String   @default("") // Koda za aktivacijo
  // --- Omejitve ---
  maxUses     Int?     // null = neomejeno
  currentUses Int      @default(0)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // --- Relations ---
  orderItems  OrderItem[]
  checks      Check[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// DOSTAVA (Toast Delivery)
// ============================================

model DeliveryInfo {
  id              String   @id @default(cuid())
  // --- Naslov ---
  address         String   // Ulica in hišna številka
  city            String   @default("")
  postCode        String   @default("")
  // --- Kontakt ---
  recipientName   String   @default("")
  recipientPhone  String   @default("")
  deliveryInstructions String @default("") // Navodila za dostavo (npr. "3. nadstropje, levo")
  // --- Čas ---
  promisedTime    DateTime? // Obljubljen čas dostave
  estimatedTime   DateTime? // Predviden čas dostave
  actualTime      DateTime? // Dejanski čas dostave
  // --- Courier ---
  courierName     String   @default("")
  courierPhone    String   @default("")
  // --- Status ---
  status          String   @default("pending") // pending, preparing, ready, picked_up, delivered, failed
  // --- Pakiranje ---
  packagingFee    Float    @default(0) // Strošek embalaže
  deliveryFee     Float    @default(0) // Strošek dostave
  // --- Koordinate ---
  latitude        Float?
  longitude       Float?
  // --- Relations ---
  order           Order?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// ZAPOSLENI, FUNKCIJE IN URE (Toast Labor API)
// ============================================

model Employee {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @default("")
  role      String   @default("staff")
  status    String   @default("active")
  hireDate  DateTime @default(now())
  // --- Toast: PIN za prijavo v POS ---
  pin       String   @default("") // 4-mestni PIN za hitro prijavo
  // --- Relations ---
  shifts    Shift[]
  jobs      EmployeeJob[]
  timeEntries TimeEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pin])
}

model Job {
  id          String   @id @default(cuid())
  name        String   // "Natakar", "Kuhar", "Barman", "Vodja izmene", "Skladnik"
  code        String   @default("") // Kratka koda
  basePayRate Float    @default(0) // Osnovna urna postavka
  overtimeRate Float   @default(0) // Osnovna + 50% za presežek
  // --- Dovoljenja (JSON) ---
  permissions String   @default("[]") // ["take_orders", "void_items", "apply_discounts", "manage_cash", "admin"]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // --- Relations ---
  employees   EmployeeJob[]
  shifts      Shift[]
  timeEntries TimeEntry[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmployeeJob {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  payRate    Float    @default(0) // Override osnovne plače za tega zaposlenega
  isPrimary  Boolean  @default(false) // Primarna funkcija
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, jobId])
}

model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobId      String?
  job        Job?     @relation(fields: [jobId], references: [id])
  date       DateTime
  startTime  String   @default("09:00")
  endTime    String   @default("17:00")
  status     String   @default("scheduled") // scheduled, in_progress, completed, absent
  // --- Toast: Break Types ---
  breakMinutes Int    @default(30) // Skupaj minut odmora
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TimeEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  // --- Clock In/Out ---
  clockIn     DateTime
  clockOut    DateTime?
  // --- Odmor ---
  breakStart  DateTime?
  breakEnd    DateTime?
  breakMinutes Int     @default(0) // Dejansko minut odmora
  // --- Izračun ---
  totalMinutes Int     @default(0) // Skupaj minut (brez odmora)
  payRate     Float    @default(0) // Urna postavka za ta vnos
  totalPay    Float    @default(0) // totalMinutes / 60 * payRate
  // --- Tip ---
  type        String   @default("regular") // regular, overtime, holiday, sick, vacation
  status      String   @default("active") // active, approved, disputed
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// BLAGAJNA / IZMENE (Cash Register Shifts)
// ============================================

model CashRegisterShift {
  id                String   @id @default(cuid())
  employeeId        String?
  employeeName      String   @default("")
  status            String   @default("open")  // open, closed
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  startingCash      Float    @default(0)       // Začetno stanje gotovine
  closingCash       Float    @default(0)       // Končno stanje gotovine (dejansko štete)
  expectedCash      Float    @default(0)       // Pričakovano stanje gotovine
  cashSales         Float    @default(0)       // Prodaja v gotovini
  cardSales         Float    @default(0)       // Kartična prodaja
  mobileSales       Float    @default(0)       // Mobilna prodaja
  alternateSales    Float    @default(0)       // Alternativna plačila (boni, vavčerji)
  splitPayments     Float    @default(0)       // Deljena plačila
  totalSales        Float    @default(0)       // Skupna prodaja
  totalOrders       Int      @default(0)       // Število naročil
  totalDiscounts    Float    @default(0)       // Skupni popusti
  totalTips         Float    @default(0)       // Skupne napitnine
  totalVoided       Float    @default(0)       // Skupaj poničenih zneskov
  cashDifference    Float    @default(0)       // Razlika (dejansko - pričakovano)
  notes             String   @default("")      // Opombe ob zaključku
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model InventoryItem {
  id              String    @id @default(cuid())
  name            String
  description     String    @default("")           // Opis artikla
  image           String    @default("")           // Pot do slike
  unit            String    @default("pcs")       // Enota zaloge: steklenica, keg, kos, L, kg
  quantity        Float     @default(0)            // Količina na zalogi (v enotah)
  minQuantity     Float     @default(10)           // Minimalna količina za opozorilo
  costPerUnit     Float     @default(0)            // Nabavna cena na enoto zaloge
  supplier        String    @default("")           // Dobavitelj
  category        String    @default("general")    // Kategorija zaloge
  location         String    @default("main")       // Lokacija/skladišče: main, bar, kuhinja, hladilnik, klet, etc.
  expiryDate      DateTime?
  // --- NORMATIVI (standardizirano odmerjanje) ---
  servingsPerUnit Float     @default(1)            // Število servisov iz ene enote zaloge
  servingSize     String    @default("")           // Velikost servisa
  costPerServing  Float     @default(0)            // Strošek na servis
  // --- Povezava z menijem ---
  menuItemId      String?   @unique
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
  lastRestocked   DateTime  @default(now())
  // --- Transakcije ---
  transactions    StockTransaction[]
  recipeItems     RecipeItem[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================
// ZALOŽNE TRANSAKCIJE (sledenje vseh premikov)
// ============================================

model StockTransaction {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            String        // "procurement", "sale", "write-off", "adjustment", "return"
  quantity        Float
  previousQty     Float
  newQty          Float
  costPerUnit     Float
  totalCost       Float
  reason          String        @default("")
  note            String        @default("")
  supplierDoc     String        @default("")
  employeeName    String        @default("")
  orderId         String?
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
}

// ============================================
// RECEPTI / NORMATIVI (sestavine na jed)
// ============================================

model RecipeItem {
  id              String        @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityPerServing Float     @default(0)
  unit            String        @default("")
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([menuItemId, inventoryItemId])
}

// ============================================
// RAČUNI (Fiscal compliance - ZDDV-1)
// ============================================

model Receipt {
  id                String   @id @default(cuid())
  receiptNumber     String   @unique               // Sekvenčna številka: R-2026-000001
  orderId           String                         // Omogoča več računov na naročilo (split payments)
  order             Order    @relation(fields: [orderId], references: [id])
  // --- Podatki izdajatelja ---
  businessName      String
  businessAddress   String
  businessId        String
  taxId             String
  registerId        String   @default("BLG-001")
  // --- Davčno potrjevanje (FURS) ---
  zoi               String   @default("")
  eor               String   @default("")
  fiscalVerified    Boolean  @default(false)
  verificationDate  DateTime?
  // --- Vsebina računa ---
  subtotal          Float
  vatBreakdown      String   @default("{}")
  totalVat          Float
  discount          Float    @default(0)
  total             Float
  tip               Float    @default(0)
  totalWithTip      Float    @default(0)
  paymentMethod     String
  // --- Meta ---
  isCopy            Boolean  @default(false)
  isStorno          Boolean  @default(false)
  stornoOf          String   @default("")
  printedAt         DateTime?
  createdAt         DateTime @default(now())

  @@index([orderId])
}

// ============================================
// ZVESTOBNI PROGRAM (Toast Loyalty)
// ============================================

model LoyaltyAccount {
  id              String   @id @default(cuid())
  // --- Stranka ---
  customerName    String   @default("")
  customerPhone   String   @default("")
  customerEmail   String   @default("")
  // --- Točke ---
  pointsBalance   Int      @default(0)
  lifetimePoints  Int      @default(0)
  // --- Nivoji ---
  tier            String   @default("bronze") // bronze, silver, gold, platinum
  // --- Status ---
  isActive        Boolean  @default(true)
  // --- Relations ---
  transactions    LoyaltyTransaction[]
  payments        Payment[]
  guest           Guest?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyTransaction {
  id              String         @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount  LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  // --- Transakcija ---
  type            String         // earn, redeem, adjust, expire
  points          Int            // Pozitivno za earn, negativno za redeem
  reason          String         @default("") // "Nakup", "Rođendanski bonus", "Potečene točke"
  // --- Povezava z naročilom ---
  orderId         String?
  checkId         String?
  // --- Vrednost ---
  monetaryValue   Float          @default(0) // Vrednost v EUR, če se točke unovčijo
  createdAt       DateTime       @default(now())

  @@index([loyaltyAccountId])
}

// ============================================
// DARILNE KARTICE (Toast Gift Cards)
// ============================================

model GiftCard {
  id              String   @id @default(cuid())
  cardNumber      String   @unique               // Številka kartice
  // --- Vrednost ---
  balance         Float    @default(0)            // Trenutno stanje
  initialBalance  Float    @default(0)            // Začetna vrednost
  // --- Status ---
  status          String   @default("active")     // active, depleted, expired, suspended
  // --- Lastnik ---
  ownerName       String   @default("")
  // --- Datumi ---
  purchasedAt     DateTime @default(now())
  expiresAt       DateTime?
  // --- Relations ---
  transactions    GiftCardTransaction[]
  payments        Payment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GiftCardTransaction {
  id              String    @id @default(cuid())
  giftCardId      String
  giftCard        GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  // --- Transakcija ---
  type            String    // load, redeem, adjust, transfer
  amount          Float     // Pozitivno za load, negativno za redeem
  balanceAfter    Float     // Stanje po transakciji
  // --- Povezava ---
  orderId         String?
  checkId         String?
  note            String    @default("")
  createdAt       DateTime  @default(now())

  @@index([giftCardId])
}

// ============================================
// NASTAVITVE RESTAVRACIJE
// ============================================

model RestaurantSettings {
  id                String   @id @default(cuid())
  name              String   @default("RestaurantOS")
  address           String   @default("")
  city              String   @default("")
  postCode          String   @default("")
  phone             String   @default("")
  email             String   @default("")
  web               String   @default("")
  businessId        String   @default("")           // Matična številka podjetja
  taxId             String   @default("")           // ID za DDV (SIxxxxxxxxx)
  registerNumber    String   @default("BLG-001")    // Številka blagajne
  // --- FURS certifikat ---
  fursCertPath      String   @default("")
  fursCertPassword  String   @default("")
  fursEnvironment   String   @default("test")
  // --- DDV nastavitve ---
  defaultVatRate    Float    @default(22.0)
  reducedVatRate    Float    @default(9.5)
  // --- Loyalty nastavitve ---
  loyaltyEnabled    Boolean  @default(false)
  loyaltyPointsPerEuro Int   @default(1)            // Točk na porabljen EUR
  loyaltyPointsValue Float  @default(0.01)          // Vrednost ene točke v EUR
  // --- Ostalo ---
  receiptFooter     String   @default("")
  currency          String   @default("EUR")
  locale            String   @default("sl-SI")
  country           String   @default("SI")         // Država poslovanja: SI, HR, IT, AT, DE
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================
// HACCP DNEVNIKI
// ============================================

model HaccpEntry {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  category        String                        // temperature, cleaning, delivery, cooling, training
  title           String
  description     String   @default("")
  value           String   @default("")
  status          String   @default("ok")        // ok, warning, critical
  correctiveAction String  @default("")
  employeeName    String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================
// WEBHOOKS / INTEGRACIJE
// ============================================

model Webhook {
  id          String   @id @default(cuid())
  name        String   // "Poslano v kuhinjo", "Plačilo prejeto", "Zaloga nizka"
  url         String   // Endpoint URL
  events      String   @default("[]") // JSON: ["order.created", "order.paid", "stock.low", "shift.started"]
  isActive    Boolean  @default(true)
  secret      String   @default("") // Za podpisovanje payloada
  lastTriggered DateTime?
  failureCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ATOMICNI ŠTEVCI (Race-condition safe)
// ============================================

model Counter {
  id    String @id @default(cuid())
  name  String @unique  // "orderNumber", "receiptNumber", "checkNumber"
  value Int    @default(0)
}

// ============================================
// REVIZIJSKI DNEVNIK (Audit Log)
// PCI DSS + FURS skladnost — sledenje vseh operacij
// ============================================

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?  // ID zaposlenega, ki je izvedel operacijo
  action     String   // CREATE_ORDER, VOID_ITEM, PAYMENT, REFUND, LOGIN, STORNO, itd.
  entityType String   // Order, Payment, Receipt, StockItem, Employee, itd.
  entityId   String?  // ID entitete
  details    String   @default("{}") // JSON kontekst (kaj se je spremenilo)
  ipAddress  String   @default("")
  terminalId String?  // ID POS terminala
  chainHash  String   @default("") // SHA-256 hash za zaščito pred poseganjem

  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([userId])
  @@index([action])
}

// ============================================
// REZERVACIJE (Toast Reservations — kar imajo TouchBistro in Toast)
// ============================================

model Reservation {
  id              String   @id @default(cuid())
  // --- Stranka ---
  customerName    String
  customerPhone   String   @default("")
  customerEmail   String   @default("")
  // --- Podatki rezervacije ---
  dateTime        DateTime                     // Datum in čas rezervacije
  partySize       Int                          // Število oseb
  duration        Int      @default(120)        // Trajanje v minutah (privzeto 2h)
  // --- Miza ---
  tableId         String?
  table           Table?   @relation(fields: [tableId], references: [id])
  // --- Status ---
  status          String   @default("confirmed") // confirmed, seated, completed, cancelled, no_show
  // --- Opombe ---
  notes           String   @default("")          // Posebne želje, alergije, praznovanja
  specialRequests String   @default("")          // Npr. "Otroški stol", "Ob oknu"
  // --- Sledenje ---
  source          String   @default("walk_in")   // walk_in, phone, website, app
  employeeId      String?
  // --- Potrditev ---
  confirmedAt     DateTime?
  reminderSent    Boolean  @default(false)
  // --- Obisk ---
  actualArrival   DateTime?
  actualDeparture DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dateTime])
  @@index([status])
  @@index([tableId])
}

// ============================================
// GOST CRM / GUEST PROFILES (Toast Guest — kar imajo vsi top POS)
// Popolna zgodovina gosta, alergeni, preference, VIP status
// ============================================

model Guest {
  id              String   @id @default(cuid())
  // --- Osebni podatki ---
  firstName       String   @default("")
  lastName        String                        // Priimek (obvezen)
  email           String   @default("")
  phone           String   @default("")
  // --- Status ---
  isVip           Boolean  @default(false)
  vipSince        DateTime?
  // --- Alergeni in preference ---
  allergens       String   @default("[]")       // JSON: ["1","3","7"] (EU številke alergenov)
  dietaryPrefs    String   @default("[]")       // JSON: ["vegetarijansko","brez glutena","halal"]
  dislikes        String   @default("[]")       // JSON: ["lignji","gobe"] — kaj gost ne mara
  favoriteItems   String   @default("[]")       // JSON: ["Beefsteak","Laški teran"] — najljubše jedi
  // --- Osebni podatki ---
  birthday        DateTime?
  anniversary     DateTime?
  company         String   @default("")
  notes           String   @default("")         // Osebne opombe: "Rad sedi ob oknu"
  // --- Statistika (denormalizirano za hitre poizvedbe) ---
  totalVisits     Int      @default(0)
  totalSpent      Float    @default(0)
  avgCheckAmount  Float    @default(0)
  lastVisitAt     DateTime?
  firstVisitAt    DateTime?
  // --- Zvestoba ---
  loyaltyAccountId String?  @unique
  loyaltyAccount  LoyaltyAccount?  @relation(fields: [loyaltyAccountId], references: [id])
  // --- Povezave ---
  visits          GuestVisit[]
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastName])
  @@index([phone])
  @@index([email])
  @@index([isVip])
  @@index([lastVisitAt])
}

model GuestVisit {
  id              String   @id @default(cuid())
  guestId         String
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  // --- Podatki obiska ---
  orderId         String?                       // Povezava z naročilom
  tableId         String?
  partySize       Int      @default(1)
  // --- Zneski ---
  totalSpent      Float    @default(0)
  tipAmount       Float    @default(0)
  // --- Kvaliteta ---
  feedbackScore   Int?                          // 1-5 ocena gosta
  feedbackComment String   @default("")
  // --- Kdo je strežil ---
  employeeId      String?
  employeeName    String   @default("")
  // --- Čas ---
  arrivedAt       DateTime @default(now())
  departedAt      DateTime?
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([guestId])
  @@index([arrivedAt])
}

// ============================================
// DOBAVITELJI / SUPPLIERS (Toast Supply Chain)
// ============================================

model Supplier {
  id              String   @id @default(cuid())
  name            String                        // "Mesarija Novak", "Pivovarna Laško"
  code            String   @default("")         // Kratka koda "MN", "PL"
  // --- Kontakt ---
  contactPerson   String   @default("")
  email           String   @default("")
  phone           String   @default("")
  // --- Naslov ---
  address         String   @default("")
  city            String   @default("")
  postCode        String   @default("")
  country         String   @default("Slovenija")
  // --- Poslovni podatki ---
  businessId      String   @default("")         // Matična številka
  taxId           String   @default("")         // ID za DDV
  iban            String   @default("")         // IBAN za plačila
  bank            String   @default("")
  // --- Pogoji ---
  paymentTerms    String   @default("30 dni")   // "15 dni", "30 dni", "2% popust 10 dni"
  deliveryDays    String   @default("[]")       // JSON: ["pon","sre","pet"]
  minOrderAmount  Float    @default(0)
  // --- Ocena ---
  rating          Float    @default(0)          // 1-5 ocena dobavitelja
  // --- Status ---
  isActive        Boolean  @default(true)
  notes           String   @default("")
  // --- Relations ---
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

// ============================================
// NAROČILA DOBAVITELJEM / PURCHASE ORDERS
// ============================================

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique              // "ND-2026-000001"
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  // --- Status ---
  status          String   @default("draft")    // draft, sent, confirmed, partial, received, cancelled
  // --- Datumi ---
  orderDate       DateTime @default(now())
  expectedDate    DateTime?                     // Pričakovana dostava
  receivedDate    DateTime?                     // Dejanska dostava
  // --- Zneski ---
  subtotal        Float    @default(0)
  vatAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  // --- Dostava ---
  deliveryAddress String   @default("")
  deliveryNotes   String   @default("")
  // --- Interna ---
  requestedBy     String   @default("")         // Kdo je naročil
  approvedBy      String   @default("")         // Kdo je odobril
  notes           String   @default("")
  // --- Relations ---
  items           PurchaseOrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // --- Artikel ---
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String                           // Opis artikla
  // --- Količine ---
  quantityOrdered Float         @default(0)
  quantityReceived Float        @default(0)
  unit            String        @default("pcs")
  // --- Cene ---
  unitPrice       Float         @default(0)       // Nabavna cena na enoto
  vatRate         Float         @default(22.0)
  totalPrice      Float         @default(0)
  // --- Status ---
  status          String        @default("pending") // pending, partial, received, cancelled
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
}

// ============================================
// ČAKALNA VRSTA / WAITLIST (Toast Waitlist)
// ============================================

model WaitlistEntry {
  id              String   @id @default(cuid())
  // --- Stranka ---
  guestName       String                        // Ime stranke
  guestPhone      String   @default("")
  partySize       Int                           // Število oseb
  // --- Čakana ---
  quotedWaitMinutes Int     @default(0)         // Obljubljen čas čakanja
  actualWaitMinutes  Int    @default(0)         // Dejanski čas čakanja
  // --- Preference ---
  preferredArea   String   @default("")         // "ob oknu", "terasa", "tiho"
  specialNeeds    String   @default("")         // "otroški stol", "invalidski dostop"
  // --- Status ---
  status          String   @default("waiting")  // waiting, notified, seated, left, cancelled
  // --- Časovni zapisi ---
  checkedInAt     DateTime @default(now())
  notifiedAt      DateTime?                     // Kdaj smo obvestili goste
  seatedAt        DateTime?                     // Kdaj so sedli
  leftAt          DateTime?                     // Kdaj so odšli (brez sedeža)
  // --- Povezave ---
  tableId         String?                       // Dodeljena miza
  reservationId   String?                       // Povezana rezervacija
  notes           String   @default("")
  employeeId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([checkedInAt])
}

// ============================================
// MENIJSKI TOKOVI / COURSE MANAGEMENT (Fine dining)
// Toast Course Management — večhodni obroki
// ============================================

model Course {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // --- Tok ---
  courseNumber    Int      @default(1)          // 1=predjed, 2=juha, 3=glavna, 4=sladica
  name            String   @default("")         // "Predjed", "Juha", "Glavna jed", "Sladica"
  // --- Status ---
  status          String   @default("pending")  // pending, fired, preparing, ready, served, cancelled
  // --- Časovni zapisi ---
  firedAt         DateTime?                     // Kdaj je bilo poslano v kuhinjo
  readyAt         DateTime?                     // Kdaj je bilo pripravljeno
  servedAt        DateTime?                     // Kdaj je bilo postreženo
  // --- Opombe ---
  pacingNote      String   @default("")         // "Počasi — gosti še pijejo apertif"
  // --- Relations ---
  orderItems      OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// ============================================
// AI POGOVORNI ASISTENT / AI ASSISTANT LOG
// Beleženje AI svetovanj za analizo
// ============================================

model AIConversation {
  id              String   @id @default(cuid())
  // --- Kontekst ---
  type            String                        // "menu_optimization", "sales_forecast", "waste_prediction", "staffing", "general"
  // --- Pogovor ---
  userMessage     String                        // Kaj je uporabnik vprašal
  aiResponse      String                        // AI odgovor
  // --- Meta ---
  model           String   @default("gemini-2.0-flash")
  tokensUsed      Int      @default(0)
  responseTimeMs  Int      @default(0)
  // --- Povezave ---
  employeeId      String?
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// ============================================
// HAPPY HOUR / ČASOVNE CENIKOVNE PRAVILA
// Toast Time-based Pricing — samodejni preklop cenikov
// ============================================

model HappyHourSchedule {
  id              String   @id @default(cuid())
  name            String   // "Happy Hour", "Lunch Special", "Late Night"
  description     String   @default("")
  // --- Povezava s cenikom ---
  priceGroupId    String   // Kateri cenik se aktivira
  priceGroup      PriceGroup @relation(fields: [priceGroupId], references: [id])
  // --- Popust (alternativno — brez menjave cenika) ---
  discountType    String   @default("none") // none, percentage, fixed_amount
  discountAmount  Float    @default(0)      // Odstotek ali znesek
  // --- Časovni razpored ---
  daysOfWeek      String   @default("[1,2,3,4,5]") // JSON: 1=pon, 7=ned
  startTime       String   // "16:00"
  endTime         String   // "18:00"
  // --- Datumsko obdobje (opcijsko — za sezonske akcije) ---
  validFrom       DateTime?
  validTo         DateTime?
  // --- Omejitve ---
  appliesTo       String   @default("all") // all, category_ids, menu_item_ids
  appliesToIds    String   @default("[]")  // JSON array ID-jev
  // --- Status ---
  isActive        Boolean  @default(true)
  autoActivate    Boolean  @default(true)  // Samodejno aktiviraj ob času
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
