  // --- Voznik ---
  driverName      String   @default("")
  driverPhone     String   @default("")
  vehicleInfo     String   @default("")              // Npr. "Rdeč Fiat 500, LJ-123-AB"
  // --- GPS koordinate ---
  currentLat      Float?
  currentLng      Float?
  lastUpdateAt    DateTime?
  // --- Status ---
  status          String   @default("assigned")      // assigned, picked_up, on_the_way, arriving, delivered, failed
  // --- ETA ---
  estimatedArrival DateTime?
  // --- Časovnica ---
  assignedAt      DateTime?
  pickedUpAt      DateTime?
  onTheWayAt      DateTime?
  deliveredAt     DateTime?
  // --- Ocena ---
  customerRating  Int?
  customerFeedback String  @default("")
  // --- Multi-location ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deliveryInfoId])
  @@index([status])
  @@index([driverName])
  @@index([locationId])  // FIX: Multi-location poizvedbe po lokaciji
  @@index([estimatedArrival])  // FIX: Iskanje aktivnih dostav po času prihoda
}

// ============================================
// SEJE (Session Persistence)
// FIX MEDIUM: Seje shranjene v SQLite — preživijo restart strežnika
// Hibridni pristop: pomnilniški cache + SQLite persistenca
// ============================================

model Session {
  id              String   @id @default(cuid())
  token           String   @unique              // Bearer token (64 hex znakov)
  employeeId      String                        // ID zaposlenega
  role            String                        // admin, manager, staff
  permissions     String   @default("[]")       // JSON array: ["take_orders", "void_items", ...]
  // FIX WORKFLOW-45: prej BigInt — ne deluje s pglite-prisma-adapter (BigInt se
  // serializira kot float, PostgreSQL ga zavrne). DateTime (TIMESTAMP) shrani
  // ms-precision nativno in je prava izbiba za seje.
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  absoluteExpiry  DateTime                      // Absolutni maksimum (24h)
  ipAddress       String   @default("")         // IP naslov ob prijavi
  userAgent       String   @default("")         // User-Agent ob prijavi

  @@index([token])
  @@index([employeeId])
  @@index([expiresAt])
  @@index([employeeId, expiresAt])  // Iskanje aktivnih sej za zaposlenega
}

// ============================================
// KNJIGOVODSTVO — Double-entry (Faza 1)
// JournalEntry + JournalLine za trial balance, P&L, balance sheet
// ============================================

model JournalEntry {
  id           String         @id @default(cuid())
  entryNumber  String         @unique           // JE-YYYY-NNNNNN
  date         DateTime       @default(now())
  reference    String         @default("")      // ID povezanega dokumenta (Order/Payment/Expense)
  referenceType String        @default("")      // order, payment, expense, refund, adjustment
  description  String         @default("")
  source       String         @default("manual") // manual, auto-order, auto-payment, auto-expense
  status       String         @default("posted") // draft, posted, reversed
  postedAt     DateTime?
  postedBy     String?         // Employee ID
  postedById   String?                            // FIX issue #43: FK do Employee
  postedByEmp  Employee?      @relation("PostedJournalEntries", fields: [postedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // --- Multi-location (issue #31) ---
  locationId   String?
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Relacije ---
  lines        JournalLine[]
  // --- Meta ---
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([date])
  @@index([reference])
  @@index([referenceType])
  @@index([status])
  @@index([source])
  @@index([date, status])
  @@index([locationId])
}

// ============================================
// KONTNI NAČRT (Chart of Accounts) — SKM 2006
// Slovenski standardni kontni načrt za knjigovodstvo
// ============================================

model ChartOfAccount {
  id          String   @id @default(cuid())
  code        String   @unique              // 1010, 2600, 7000, itd.
  name        String                        // "Blagajna", "DDV izhodni", "Promet — na mestu"
  accountType String                        // asset, liability, equity, revenue, expense
  parentId    String?                       // Hierarhija: 7000 → 7000.01 (subkonta)
  parent      ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subAccounts ChartOfAccount[]  @relation("AccountHierarchy")
  isActive    Boolean  @default(true)
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountType])
  @@index([parentId])
  @@index([isActive])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade) // FIX: Restrict — ne briši knjigovodske postavke
  // --- Konto ---
  accountCode    String                     // Kontni načrt (npr. 7000=Promet, 2600=DDV, 1000=Banka, 1010=Blagajna)
  accountName    String                     // Ime konta
  accountType    String                     // asset, liability, equity, revenue, expense
  // --- Zneski (double-entry: vsaj 2 vrstici, debiti == krediti) ---
  debit          Decimal       @default(0)  // FIX: Decimal za valuto
  credit         Decimal       @default(0)  // FIX: Decimal za valuto
  // --- Opis ---
  description    String        @default("")
  // --- Meta ---
  createdAt      DateTime      @default(now())

  @@index([journalEntryId])
  @@index([accountCode])
  @@index([accountType])
  @@index([accountCode, accountType])
}

// ============================================
// OBVEZNOSTI DOBAVITELJEM (Accounts Payable) — Faza 3
// Sledi neplačanim računom dobaviteljev, aging, partial payments
// ============================================

model AccountsPayable {
  id              String    @id @default(cuid())
  apNumber        String    @unique             // AP-YYYY-NNNNNN
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseOrderId String?                       // Povezava z nabavnim naročilom
  // --- Račun dobavitelja ---
  invoiceNumber   String     @default("")       // Številka računa dobavitelja
  invoiceDate     DateTime   @default(now())    // Datum računa
  dueDate         DateTime                      // Datum zapadlosti
  // --- Zneski ---
  subtotal        Decimal                       // Bruto brez DDV
  vatAmount       Decimal    @default(0)        // DDV
  totalAmount     Decimal                       // Skupaj z DDV
  paidAmount      Decimal    @default(0)        // Kaj je že plačano (partial payments)
  // --- Status ---
  status          String     @default("open")   // open, partial, paid, overdue, cancelled
  paidAt          DateTime?
  // --- Meta ---
  notes           String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])  // Aging report: open/overdue po datumu
}

// ============================================
// TERJATVE STRANK (Accounts Receivable) — Faza 3
// Sledi neplačanim računom strank (B2B, catering, corporate)
// ============================================

model AccountsReceivable {
  id              String    @id @default(cuid())
  arNumber        String    @unique             // AR-YYYY-NNNNNN
  orderId         String?                       // Povezava z naročilom (če je iz POS)
  guestId         String?                       // Povezava z gostom
  // --- Stranka ---
  customerName    String                        // Ime stranke (B2B)
  customerTaxId   String     @default("")       // Davčna številka stranke
  customerEmail   String     @default("")       // Za pošiljanje računa
  // --- Račun ---
  invoiceNumber   String     @default("")
  invoiceDate     DateTime   @default(now())
  dueDate         DateTime
  // --- Zneski ---
  subtotal        Decimal
  vatAmount       Decimal    @default(0)
  totalAmount     Decimal
  paidAmount      Decimal    @default(0)
  // --- Status ---
  status          String     @default("open")   // open, partial, paid, overdue, cancelled
  paidAt          DateTime?
  // --- Meta ---
  notes           String     @default("")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([customerTaxId])
}

// ============================================
// DNEVNIK EMAIL POROČIL (Scheduled Email Log) — Faza 3
// Sledi poslanim email poročilom (Z-report, dnevni/tedenski summary)
// ============================================

model ScheduledEmailLog {
  id              String    @id @default(cuid())
  reportType      String                        // z_report, daily_summary, weekly_summary, vat_report
  recipient       String                        // Email naslov prejemnika
  subject         String
  body            String     @default("")       // Email vsebina (preview)
  attachmentName  String     @default("")       // Ime priponke (npr. Z-report_2026-06-17.pdf)
  status          String     @default("pending") // pending, sent, failed
  errorMessage    String     @default("")       // Napaka če failed
  sentAt          DateTime?
  // --- Povezani podatki ---
  reportDate      DateTime?                     // Datum poročila (ne datum pošiljanja)
  createdAt       DateTime   @default(now())

  @@index([status])
  @@index([reportType])
  @@index([createdAt])
  @@index([recipient])
}

// ============================================
// WEB PUSH SUBSCRIPTIONS — Push notifications
// ============================================

model PushSubscription {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation("PushSubscriptions", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  endpoint    String   // Push service URL (FCM, Apple, Mozilla)
  p256dhKey   String   // P-256 public key
  authKey     String   // Auth secret
  userAgent   String   @default("")  // Za identifikacijo naprave
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
  @@index([endpoint])
  @@index([isActive])
}

// ============================================
// KOT (Kitchen Order Ticket) — URY Mosaic-style
// Eksplicitni dokument za vsako spremembo v kuhinji
// Tipi: original, modified, partially_cancelled, cancelled
// Barvno kodiranje na KDS: white=original, blue=takeaway, orange=modified, red=cancelled
// ============================================

model KotDocument {
  id              String   @id @default(cuid())
  kotNumber       Int                          // Sekvenčna številka KOT
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type            String   @default("original") // original, modified, partially_cancelled, cancelled
  // --- Vsebina KOT (snapshot ob trenutku izdaje) ---
  itemsJson       String   @default("[]")       // JSON: [{name, qty, notes, station}]
  orderNotes      String   @default("")
  tableNumber     Int?
  orderType       String   @default("dine-in")  // dine-in, takeaway, delivery
  // --- Status ---
  status          String   @default("pending")  // pending, preparing, ready, served, cancelled
  // --- Časovne oznake ---
  firedAt         DateTime?
  readyAt         DateTime?
  servedAt        DateTime?
  cancelledAt     DateTime?
  // --- Kdo je izdal/spremenil ---
  employeeId      String?
  employee        Employee? @relation("KotDocuments", fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cancelReason    String   @default("")
  // --- Povezava s prejšnjim KOT (za modified/cancelled) ---
  previousKotId   String?
  // --- Meta ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([employeeId])
}

// ============================================
// VIRTUAL BRAND / GHOST KITCHEN — Multi-brand mode
// Ena fizična kuhinja, več virtualnih blagovnih znamk (ghost kitchen hub)
// ============================================

model VirtualBrand {
  id              String   @id @default(cuid())
  name            String                        // "Burger Lab", "Pizza Express", "Sushi Bar"
  code            String   @unique              // Kratka koda: "BL", "PE", "SB"
  description     String   @default("")
  logo            String   @default("")
  color           String   @default("#f59e0b")  // Barva za KDS prikaz
  isActive        Boolean  @default(true)
  // --- Povezana lokacija (ghost kitchen) ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Nastavitve ---
  ownMenu         Boolean  @default(true)       // Ali ima lasten meni ali deli z glavnim
  ownPricing      Boolean  @default(true)       // Ali ima lastne cene
  orderPrefix     String   @default("")          // Prefix za naročila (BL-001, PE-001)
  // --- Dostava ---
  deliveryEnabled Boolean  @default(true)
  pickupEnabled   Boolean  @default(true)
  // --- Relations ---
  orders          Order[]                         // Povezana naročila
  // --- Meta ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([locationId])
}

// ============================================
// CARBON FOOTPRINT — Sustainability tracking
// Per-dish CO2e izračun iz sestavin (LCA database)
// ============================================

model CarbonFactor {
  id              String   @id @default(cuid())
  name            String                        // "Goveje meso", "Piščanec", "Paradižnik", "Riž"
  category        String   @default("ingredient") // ingredient, packaging, transport
  co2ePerKg       Decimal                        // kg CO2e per kg produkta (LCA)
  unit            String   @default("kg")        // kg, L, kos
  source          String   @default("Agribalyse") // Vir podatkov (Agribalyse, Klimato, lasten)
  // --- Detail ---
  waterUsage      Decimal?                       // L vode per kg (water footprint)
  landUse         Decimal?                       // m² per kg
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([name, category])
  @@index([category])
  @@index([isActive])
}

model SustainabilityReport {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  // --- Sestavine ---
  totalCo2e       Decimal  @default(0)            // kg CO2e skupno
  totalWater      Decimal  @default(0)            // L vode skupno
  totalLand       Decimal  @default(0)            // m² skupno
  // --- Promet ---
  totalOrders     Int      @default(0)
  totalRevenue    Decimal  @default(0)
  // --- Izračuni ---
  co2ePerOrder    Decimal  @default(0)            // kg CO2e per naročilo
  co2ePerEuro     Decimal  @default(0)            // kg CO2e per € prometa
  // --- Waste ---
  foodWasteKg     Decimal  @default(0)            // Kg zavrnjene hrane
  packagingWasteKg Decimal @default(0)            // Kg embalaže
  // --- Meta ---
  locationId      String?
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([locationId])
}

// ============================================
// OFFLINE OUTBOX — Transactional outbox pattern
// ============================================
// Ko POS dela offline (brez povezave do FURS/Stripe/itd.),
// se transakcije zapišejo v outbox. Sync engine jih nato
// poskusi ponovno poslati, ko je povezava nazaj.
//
// Pattern je行业标准 2025 (Microservices + offline-first POS).
// ============================================
model OutboxEvent {
  id              String   @id @default(cuid())
  // --- Kaj ---
  aggregateType   String                       // "order", "invoice", "furs_invoice", "payment"
  aggregateId     String                       // ID entitete (npr. Order.id)
  eventType       String                       // "created", "updated", "voided", "paid"
  // --- Payload ---
  payload         Json                         // Celotni podatki za ponovno pošiljanje
  // --- Cilj ---
  target          String                       // "furs", "stripe", "email", "sms", "webhook", "internal"
  targetEndpoint  String   @default("")        // URL ali handler ID
  // --- Status ---
  status          String   @default("pending") // pending, processing, sent, failed, dead_letter
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  // --- Napaka ---
  lastError       String   @default("")
  // --- Ključ za idempotentnost ---
  idempotencyKey  String   @unique             // prepreči duplikate pri retry-jih
  // --- Čas ---
  nextRetryAt     DateTime?
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([target, status])
  @@index([aggregateType, aggregateId])
  @@index([createdAt])
}

// ============================================
// SYNC STATE — sledi statusu sinhronizacije per entiteta
// ============================================
model SyncState {
  id              String   @id @default(cuid())
  // --- Kaj ---
  entityType      String                       // "order", "menu_item", "employee"
  entityId        String                       // ID entitete
  // --- Status ---
  lastSyncedAt    DateTime?
  syncVersion     Int      @default(0)         // Vector clock — poveča se ob vsaki spremembi
  // --- Konflikt ---
  conflictStatus  String   @default("none")    // none, detected, resolved
  conflictData    Json?
  // --- Meta ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([lastSyncedAt])
  @@index([conflictStatus])
}

// ============================================
// DEVICE REGISTRY — sledi POS napravam in offline stanju
// ============================================
model DeviceRegistry {
  id              String   @id @default(cuid())
  // --- Identifikacija ---
  deviceId        String   @unique             // Hardware ID ali browser fingerprint
  name            String                       // "POS-1", "KDS-kuhinja", "Tablet-3"
  // --- Lokacija ---
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Tip ---
  type            String   @default("pos")     // pos, kds, tablet, mobile, kiosk
  // --- Status ---
  status          String   @default("offline") // online, offline, sleeping
  lastSeenAt      DateTime?
  // --- Verzija ---
  appVersion      String   @default("")
  // --- Meta ---
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([status])
}

// ============================================
// WALLET PAYMENT — Apple Pay / Google Pay / NFC
// ============================================
// Sledi contactless plačilom preko mobilnih denarnic.
// PCI DSS 4.0.1 obvezno od 31. marca 2025.
// ============================================
model WalletPayment {
  id                String   @id @default(cuid())
  // --- Povezava s Payment ---
  paymentId         String?                              // opcijsko — povezava z glavnim Payment zapisom
  checkId           String?                              // opcijsko — povezava s Check
  // --- Tip denarnice ---
  walletType        String                               // apple_pay, google_pay, samsung_pay, nfc_card, qr_pay
  // --- Transaction info ---
  transactionId     String   @default("")                // ID iz denarnice (Apple Pay paymentToken id)
  merchantId        String   @default("")                // Naš merchant identifier
  // --- Znesek ---
  amount            Decimal                              // Plačani znesek
  currency          String   @default("EUR")
  // --- Tokenization ---
  paymentToken      String   @default("")                // Encrypted token iz denarnice
  tokenType         String   @default("")                // PKPaymentToken, Google paymentData, itd.
  // --- Card info (iz tokena) ---
  cardBrand         String   @default("")                // visa, mastercard, amex, discover
  cardLast4         String   @default("")
  // --- Status ---
  status            String   @default("pending")         // pending, authorized, captured, failed, refunded
  capturedAt        DateTime?
  refundedAmount    Decimal  @default(0)
  // --- Napaka ---
  errorCode         String   @default("")
  errorMessage      String   @default("")
  // --- Device info ---
  deviceId          String?                              // Katera POS naprava je sprejela
  // --- Meta ---
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentId])
  @@index([checkId])
  @@index([walletType, status])
  @@index([transactionId])
  @@index([createdAt])
}

// ============================================
// QUICKBOOKS ONLINE — OAuth + Sync state
// ============================================
// Za sinhronizacijo z QuickBooks Online (USA trg).
// OAuth 2.0 z refresh token, sync state per entiteta.
// ============================================
model QuickBooksSync {
  id                String   @id @default(cuid())
  // --- OAuth credentials (encrypted) ---
  accessToken       String   @default("")        // Encrypted access token
  refreshToken      String   @default("")        // Encrypted refresh token
  realmId           String   @unique             // QBO company ID
  companyId         String   @default("")        // QBO company name
  // --- Token metadata ---
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  // --- Sync state ---
  lastSyncAt        DateTime?
  lastSyncStatus    String   @default("never")   // never, success, failed, partial
  lastSyncError     String   @default("")
  // --- Entity sync tracking ---
  lastCustomerSync  DateTime?
  lastPaymentSync   DateTime?
  lastInvoiceSync   DateTime?
  lastJournalSync   DateTime?
  // --- Status ---
  isActive          Boolean  @default(true)
  // --- Meta ---
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([lastSyncAt])
}

// ============================================
// QUICKBOOKS SYNC LOG — audit trail
// ============================================
model QuickBooksSyncLog {
  id                String   @id @default(cuid())
  syncId            String                          // Reference to QuickBooksSync
  // --- Kaj ---
  entityType        String                          // customer, payment, invoice, journal, vendor
  entityId          String                          // Lokalni ID
  qbEntityId        String?                         // QBO ID (če uspešno sinhronizirano)
  // --- Status ---
  status            String   @default("pending")   // pending, success, failed, skipped
  action            String   @default("create")    // create, update, delete, query
  // --- Napaka ---
  errorCode         String   @default("")
  errorMessage      String   @default("")
  // --- Payload (debug) ---
  requestPayload    Json?
  responsePayload   Json?
  // --- Čas ---
  syncedAt          DateTime?
  createdAt         DateTime @default(now())

  @@index([syncId])
  @@index([entityType, status])
  @@index([entityId])
  @@index([createdAt])
}

// ============================================
// VIDEO ANALYTICS — Šetenje gostov in heat maps
// ============================================
// Za analizo prometa v restavraciji (kamera-based).
// V produkciji: ML model za person detection.
// ============================================
model VideoAnalyticsSession {
  id                String   @id @default(cuid())
  // --- Kamera ---
  cameraId          String                          // ID kamere
  cameraName        String   @default("")
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: SetNull)
  // --- Seja ---
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  // --- Statistika ---
  peopleIn          Int      @default(0)            // Št. ljudi ki je vstopilo
  peopleOut         Int      @default(0)            // Št. ljudi ki je izstopilo
  currentOccupancy  Int      @default(0)            // Trenutna zasedenost
  peakOccupancy     Int      @default(0)            // Najvišja zasedenost
  // --- Heat map ---
  heatmapData       Json?                            // {x, y, intensity}[]
  // --- Status ---
  status            String   @default("active")     // active, paused, stopped
  // --- Meta ---
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cameraId])
  @@index([locationId])
  @@index([startedAt])
}

// ============================================
// BLOCKCHAIN AUDIT — Tamper-evident audit trail
// ============================================
// Za FURS/PCI compliance — vsaka kritična transakcija
// je zabeležena z hash chain (podobno kot AuditLog).
// ============================================
model BlockchainAuditEntry {
  id                String   @id @default(cuid())
  // --- Chain ---
  blockNumber       Int      @unique               // Sequence number
  previousHash      String                          // Hash prejšnjega bloka
  currentHash       String                          // Hash tega bloka
  // --- Vsebina ---
  entityType        String                          // order, payment, refund, void, cash_shift
  entityId          String                          // ID entitete
  action            String                          // create, update, delete, void, refund
  // --- Podatki ---
  payload           Json                            // Celotni podatki
  // --- Podpis ---
  signature         String   @default("")           // Digitalni podpis (HMAC ali RSA)
  // --- Čas ---
  timestamp         DateTime @default(now())
  // --- Miner (kdo je ustvaril blok) ---
  minerId           String?                         // Employee ID ali system

  @@index([blockNumber])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([currentHash])
}
