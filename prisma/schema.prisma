// ============================================
// HAPPY HOUR / ČASOVNE CENIKOVNE PRAVILA
// Toast Time-based Pricing — samodejni preklop cenikov
// ============================================

model HappyHourSchedule {
  id              String   @id @default(cuid())
  name            String   // "Happy Hour", "Lunch Special", "Late Night"
  description     String   @default("")
  // --- Povezava s cenikom ---
  priceGroupId    String   // Kateri cenik se aktivira
  priceGroup      PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // --- Popust (alternativno — brez menjave cenika) ---
